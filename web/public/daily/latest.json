          "answers_en": ["Sure, let's go!", "Good idea!"]
        },
        {
          "partner_zh": "你想喝什么？",
          "partner_en": "What do you want to drink?",
          "prompt_en": "Say an iced cola.",
          "answers_zh": ["我想喝冰可乐。", "来一杯冰可乐。"],
          "answers_en": ["I'd like an iced cola.", "An iced cola, please."]
        },
        {
          "partner_zh": "我请你！",
          "partner_en": "My treat!",
          "prompt_en": "Say thanks, you're really happy.",
          "answers_zh": ["谢谢！我很高兴。", "太好了，谢谢你！"],
          "answers_en": ["Thanks! That makes me happy.", "Great, thank you!"]
        }
      ],
      "closing_zh": "不客气！",
      "closing_en": "You're welcome!"
    }
  ]
