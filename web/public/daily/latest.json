      "title_zh": "朋友教我",
      "title_en": "My friend teaches me",
      "paragraphs": [
        ["我", "很", "喜欢", "日本", "的", "电影", "。", "现在", "，", "我", "也", "想", "读", "日本", "的", "书", "。"],
        ["日本", "的", "字", "很", "难", "。", "很", "多", "字", "我", "都", "不", "认识", "。"],
        ["我", "的", "朋友", "是", "日本", "人", "。", "她", "说", "：", "“", "我", "来", "教", "你", "！", "”"],
        ["她", "晚上", "来", "我", "家", "，", "教", "我", "两", "个", "小时", "。", "她", "很", "认真", "。", "我", "写", "错", "了", "，", "她", "就", "再", "告诉", "我", "一", "次", "。"],
        ["现在", "，", "我", "能", "读", "一些", "了", "！"]
      ],
      "translations": [
        "I really like Japanese films. Now I want to read Japanese books too.",
        "Japanese characters are hard. There are lots of characters I don't know.",
        "My friend is Japanese. She said: “I’ll teach you!”",
        "She comes to my place in the evening and teaches me for two hours. She's very thorough. When I write something wrong, she tells me again.",
        "Now I can read a bit!"
      ],
      "names": ["日本"],
      "new_words": ["读", "教", "认真"],
      "glossary": [
        { "word": "读", "english": "to read" },
        { "word": "教", "english": "to teach" },
        { "word": "认真", "english": "serious; thorough" },
        { "word": "日本", "english": "Japan" }
      ]
    },
