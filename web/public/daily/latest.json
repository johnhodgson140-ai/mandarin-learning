  "missions": [
    {
      "id": "2026-11-17-m1",
      "level": 2,
      "title": "A birthday invitation",
      "role": "朋友",
      "goal": "Invite your friend to your birthday dinner and tell them what (not) to bring.",
      "new_words": [
        {
          "word": "一定",
          "english": "definitely"
        },
        {
          "word": "带",
          "english": "to bring"
        },
        {
          "word": "大家",
          "english": "everyone"
        }
      ],
      "steps": [
        {
          "partner_zh": "你明天晚上有时间吗？",
          "partner_en": "Are you free tomorrow evening?",
          "prompt_en": "Say it's your birthday — invite them to dinner.",
          "answers_zh": [
            "明天是我的生日，来吃饭吧！",
            "明天我生日，你来吃饭吗？"
          ],
          "answers_en": [
            "It's my birthday tomorrow — come for dinner!",
            "It's my birthday tomorrow, will you come for dinner?"
          ]
        },
        {
          "partner_zh": "好啊！几点？在哪儿？",
          "partner_en": "Great! What time? Where?",
          "prompt_en": "Say seven o'clock, at your place.",
          "answers_zh": [
            "晚上七点，在我家。",
            "七点，来我家。"
          ],
          "answers_en": [
            "Seven in the evening, at my place.",
            "Seven, come to mine."
          ]
        },
        {
          "partner_zh": "我应该带什么？",
          "partner_en": "What should I bring?",
          "prompt_en": "Say nothing, just come.",
          "answers_zh": [
            "不用带东西，你来就好。",
            "什么都不用带。"
          ],
          "answers_en": [
            "No need to bring anything, just come.",
            "You don't need to bring anything."
          ]
        },
        {
          "partner_zh": "好，还有谁来？",
          "partner_en": "OK, who else is coming?",
          "prompt_en": "Say everyone from class.",
          "answers_zh": [
            "大家都来，我们班的同学。",
            "大家都来！"
          ],
          "answers_en": [
            "Everyone — the people from our class.",
            "Everyone's coming!"
          ]
        }
      ],
      "closing_zh": "太好了，我一定去！",
      "closing_en": "Brilliant, I'll definitely be there!"
    },
    {
      "id": "2026-11-17-m2",
      "level": 2,
      "title": "A table for two",
      "role": "服务员",
      "goal": "Get a table at a busy restaurant and order with the waiter's help.",
      "new_words": [
        {
          "word": "位",
          "english": "(polite measure word for people)"
        },
        {
          "word": "这么",
          "english": "so (this much)"
        },
        {
          "word": "应该",
          "english": "should"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，几位？",
          "partner_en": "Hello, how many?",
          "prompt_en": "Say two people.",
          "answers_zh": [
            "两位。",
            "两个人。"
          ],
          "answers_en": [
            "Two.",
            "Two people."
          ]
        },
        {
          "partner_zh": "现在没有位子了，要等一会儿。",
          "partner_en": "There are no tables right now — you'll have to wait a bit.",
          "prompt_en": "Say wow, so many people! Ask how long.",
          "answers_zh": [
            "这么多人啊！要等多长时间？",
            "人这么多！等多长时间？"
          ],
          "answers_en": [
            "So many people! How long's the wait?",
            "So busy! How long?"
          ]
        },
        {
          "partner_zh": "十分钟。好了，请坐。你们吃什么？",
          "partner_en": "Ten minutes. … Right, have a seat. What would you like?",
          "prompt_en": "Ask what you should order.",
          "answers_zh": [
            "我们应该吃什么？",
            "你说我们应该点什么？"
          ],
          "answers_en": [
            "What should we have?",
            "What do you think we should order?"
          ]
        },
        {
          "partner_zh": "这个菜大家都喜欢。",
          "partner_en": "Everyone loves this dish.",
          "prompt_en": "Say OK, you'll have that one, and two teas.",
          "answers_zh": [
            "好，就要这个，还要两杯茶。",
            "好的，来一个，两杯茶。"
          ],
          "answers_en": [
            "OK, we'll have that, and two teas.",
            "Sure, one of those, and two teas."
          ]
        }
      ],
      "closing_zh": "好的，马上来！",
      "closing_en": "Coming right up!"
    }
  ]
