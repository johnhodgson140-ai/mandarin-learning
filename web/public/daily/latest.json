  "missions": [
    {
      "id": "2026-10-05-m1",
      "level": 1,
      "title": "Buying cinema tickets",
      "role": "售票员",
      "goal": "Choose a film and a time, buy two tickets, pick seats and promise not to be late.",
      "new_words": [
        { "word": "电影", "english": "film; movie" },
        { "word": "哪", "english": "which" },
        { "word": "晚", "english": "late" }
      ],
      "steps": [
        {
          "partner_zh": "你好，看哪个电影？",
          "partner_en": "Hi, which film would you like to see?",
          "prompt_en": "Say you want to see this one.",
          "answers_zh": ["我看这个。", "我要看这个电影。"],
          "answers_en": ["This one.", "I'd like to see this film."]
        },
        {
          "partner_zh": "几点的？",
          "partner_en": "What time?",
          "prompt_en": "Ask if there's one at eight this evening.",
          "answers_zh": ["有晚上八点的吗？", "晚上八点的有吗？"],
          "answers_en": ["Is there one at eight this evening?", "Do you have the eight o'clock showing?"]
        },
        {
          "partner_zh": "有。要几张？",
          "partner_en": "Yes. How many tickets?",
          "prompt_en": "Say two tickets.",
          "answers_zh": ["两张。", "我要两张票。"],
          "answers_en": ["Two.", "Two tickets, please."]
        },
        {
          "partner_zh": "好的，一共九十块。想坐哪儿？",
          "partner_en": "OK, that's 90 kuai altogether. Where would you like to sit?",
          "prompt_en": "Say in the middle, please.",
          "answers_zh": ["中间的，谢谢。", "坐中间吧。"],
          "answers_en": ["In the middle, thanks.", "Let's sit in the middle."]
        },
        {
          "partner_zh": "电影八点开始，别来晚了！",
          "partner_en": "The film starts at eight — don't be late!",
          "prompt_en": "Say OK, you won't be late.",
          "answers_zh": ["好的，我们不会晚的。", "好，不会来晚的。"],
          "answers_en": ["OK, we won't be late.", "Sure, we won't be late."]
        }
      ],
      "closing_zh": "好的，这是你们的票。",
      "closing_en": "OK, here are your tickets."
    },
    {
      "id": "2026-10-05-m2",
      "level": 1,
      "title": "At a bookshop",
      "role": "店员",
      "goal": "Find a book for learning Chinese, ask the price, ask about other options and buy one.",
      "new_words": [
        { "word": "书", "english": "book" },
        { "word": "别的", "english": "other; else" },
        { "word": "多少", "english": "how much; how many" }
      ],
      "steps": [
        {
          "partner_zh": "你好，找什么书？",
          "partner_en": "Hi, what book are you looking for?",
          "prompt_en": "Say you want a book for learning Chinese.",
          "answers_zh": ["我想找一本学中文的书。", "有学中文的书吗？"],
          "answers_en": ["I'm looking for a book for learning Chinese.", "Do you have books for learning Chinese?"]
        },
        {
          "partner_zh": "有，在这里。这本很好。",
          "partner_en": "Yes, over here. This one's very good.",
          "prompt_en": "Ask how much it is.",
          "answers_zh": ["这本多少钱？", "多少钱？"],
          "answers_en": ["How much is this one?", "How much?"]
        },
        {
          "partner_zh": "四十八块。",
          "partner_en": "48 kuai.",
          "prompt_en": "Ask if they have any others.",
          "answers_zh": ["还有别的吗？", "有别的吗？"],
          "answers_en": ["Do you have any others?", "Anything else?"]
        },
        {
          "partner_zh": "这本也不错，三十块，可是有点难。",
          "partner_en": "This one's good too, 30 kuai, but it's a bit hard.",
          "prompt_en": "Say you'll take the first one.",
          "answers_zh": ["我还是要第一本吧。", "我要第一本。"],
          "answers_en": ["I'll go with the first one.", "I'll take the first one."]
        },
        {
          "partner_zh": "好的。还要别的吗？",
          "partner_en": "OK. Anything else?",
          "prompt_en": "Say that's all, thanks.",
          "answers_zh": ["不要了，谢谢。", "就这些，谢谢！"],
          "answers_en": ["No, thanks.", "That's all, thanks!"]
        }
      ],
      "closing_zh": "好的，一共四十八块。欢迎再来！",
      "closing_en": "OK, that's 48 kuai. Come again!"
    }
  ]
}
