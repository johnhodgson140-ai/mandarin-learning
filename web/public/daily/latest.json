  "missions": [
    {
      "id": "2026-11-21-m1",
      "level": 2,
      "title": "Joining a club",
      "role": "同学",
      "goal": "A classmate runs the football club. Ask to join and find out when it meets.",
      "new_words": [
        {
          "word": "参加",
          "english": "to join; to take part in"
        },
        {
          "word": "周",
          "english": "week"
        },
        {
          "word": "或者",
          "english": "or"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！你想参加我们的球队吗？",
          "partner_en": "Hi! Do you want to join our team?",
          "prompt_en": "Say yes, you love playing football.",
          "answers_zh": [
            "想！我很喜欢打球。",
            "我想参加，我很爱打球。"
          ],
          "answers_en": [
            "Yes! I love playing football.",
            "I'd like to join — I love football."
          ]
        },
        {
          "partner_zh": "太好了。你叫什么名字？",
          "partner_en": "Great. What's your name?",
          "prompt_en": "Give your name.",
          "answers_zh": [
            "我叫李明。",
            "我的名字是李明。"
          ],
          "answers_en": [
            "I'm Li Ming.",
            "My name's Li Ming."
          ]
        },
        {
          "partner_zh": "我们一周打两次。",
          "partner_en": "We play twice a week.",
          "prompt_en": "Ask which days.",
          "answers_zh": [
            "星期几打？",
            "哪两天？"
          ],
          "answers_en": [
            "Which days?",
            "Which two days?"
          ]
        },
        {
          "partner_zh": "星期二或者星期四，下午四点。",
          "partner_en": "Tuesday or Thursday, at four in the afternoon.",
          "prompt_en": "Say great, you'll come on Tuesday.",
          "answers_zh": [
            "好，我星期二来。",
            "没问题，星期二见！"
          ],
          "answers_en": [
            "Great, I'll come on Tuesday.",
            "No problem, see you Tuesday!"
          ]
        }
      ],
      "closing_zh": "好，星期二见！",
      "closing_en": "OK, see you on Tuesday!"
    },
    {
      "id": "2026-11-21-m2",
      "level": 2,
      "title": "Lost wallet",
      "role": "火车站工作人员",
      "goal": "You've lost your wallet at the station. Report it at the help desk.",
      "new_words": [
        {
          "word": "见到",
          "english": "to see"
        },
        {
          "word": "安全",
          "english": "safe"
        },
        {
          "word": "出现",
          "english": "to turn up"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么事情？",
          "partner_en": "Hello, how can I help?",
          "prompt_en": "Say you can't find your wallet.",
          "answers_zh": [
            "我的钱包找不到了。",
            "我找不到我的钱包了。"
          ],
          "answers_en": [
            "I can't find my wallet.",
            "I've lost my wallet."
          ]
        },
        {
          "partner_zh": "你最后在哪儿见到它的？",
          "partner_en": "Where did you last see it?",
          "prompt_en": "Say on the train.",
          "answers_zh": [
            "在火车上。",
            "我在火车上还有。"
          ],
          "answers_en": [
            "On the train.",
            "I still had it on the train."
          ]
        },
        {
          "partner_zh": "钱包里有什么？",
          "partner_en": "What was in it?",
          "prompt_en": "Say some money and your bank card.",
          "answers_zh": [
            "有一些钱，还有我的卡。",
            "有钱和卡。"
          ],
          "answers_en": [
            "Some money, and my card.",
            "Money and a card."
          ]
        },
        {
          "partner_zh": "别着急，这里很安全。如果出现了，我们给你打电话。",
          "partner_en": "Don't worry, it's safe here. If it turns up, we'll call you.",
          "prompt_en": "Give your phone number and thank them.",
          "answers_zh": [
            "好，这是我的电话。谢谢！",
            "谢谢你，我的电话在这儿。"
          ],
          "answers_en": [
            "OK, here's my number. Thanks!",
            "Thank you — here's my number."
          ]
        }
      ],
      "closing_zh": "不客气，有消息我们马上告诉你。",
      "closing_en": "You're welcome. We'll let you know as soon as we hear anything."
    }
  ]
