        { "word": "医院", "english": "hospital" }
      ],
      "steps": [
        {
          "partner_zh": "你家有几口人？",
          "partner_en": "How many people are in your family?",
          "prompt_en": "Say four.",
          "answers_zh": ["我家有四口人。", "四口人。"],
          "answers_en": ["There are four of us.", "Four people."]
        },
        {
          "partner_zh": "都有谁？",
          "partner_en": "Who are they?",
          "prompt_en": "Say Dad, Mum, your older sister and you.",
          "answers_zh": ["爸爸、妈妈、姐姐和我。", "有爸爸妈妈、姐姐和我。"],
          "answers_en": ["Dad, Mum, my older sister and me.", "There's Dad, Mum, my older sister and me."]
        },
        {
          "partner_zh": "你姐姐做什么工作？",
          "partner_en": "What does your sister do?",
          "prompt_en": "Say she's a doctor at a hospital.",
          "answers_zh": ["她在医院工作，是医生。", "她是医生。"],
          "answers_en": ["She works at a hospital — she's a doctor.", "She's a doctor."]
        },
        {
          "partner_zh": "我有一个儿子，五岁了。",
          "partner_en": "I have a son — he's five.",
          "prompt_en": "Ask if he likes football.",
          "answers_zh": ["他喜欢足球吗？", "他喜欢踢球吗？"],
          "answers_en": ["Does he like football?", "Does he like playing football?"]
        },
        {
          "partner_zh": "喜欢！男孩子都喜欢。",
          "partner_en": "He loves it! All boys do.",
          "prompt_en": "Say bring him to play next time.",
          "answers_zh": ["下次带他来玩吧！", "下次带他一起来吧！"],
          "answers_en": ["Bring him to play next time!", "Bring him along next time!"]
        }
      ],
      "closing_zh": "好啊，下次带他来！",
      "closing_en": "Sure, I'll bring him next time!"
    }
  ]
