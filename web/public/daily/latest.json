  "missions": [
    {
      "id": "2026-11-12-m1",
      "level": 1,
      "title": "Visiting your teacher",
      "role": "老师",
      "goal": "Knock on your teacher's office door, take a seat and ask for help with today's text.",
      "new_words": [
        {
          "word": "请进",
          "english": "please come in"
        },
        {
          "word": "请坐",
          "english": "please, have a seat"
        },
        {
          "word": "课文",
          "english": "text (in a textbook)"
        }
      ],
      "steps": [
        {
          "partner_zh": "请进！",
          "partner_en": "Come in!",
          "prompt_en": "Say hello, teacher.",
          "answers_zh": [
            "老师好！",
            "老师，您好！"
          ],
          "answers_en": [
            "Hello, teacher!",
            "Hello, teacher!"
          ]
        },
        {
          "partner_zh": "你好，请坐。有什么事？",
          "partner_en": "Hello, have a seat. What can I do for you?",
          "prompt_en": "Say you don't understand today's text.",
          "answers_zh": [
            "今天的课文我不懂。",
            "我看不懂今天的课文。"
          ],
          "answers_en": [
            "I don't understand today's text.",
            "I can't understand today's text."
          ]
        },
        {
          "partner_zh": "没关系。哪个字不认识？",
          "partner_en": "No problem. Which character don't you know?",
          "prompt_en": "Say it's this one.",
          "answers_zh": [
            "这个字。",
            "是这个字。"
          ],
          "answers_en": [
            "This one.",
            "It's this one."
          ]
        },
        {
          "partner_zh": "这个字是“开”，开门的“开”。",
          "partner_en": "This character is 'open', as in 'open the door'.",
          "prompt_en": "Say you get it now, and thank them.",
          "answers_zh": [
            "我懂了，谢谢老师！",
            "知道了，谢谢！"
          ],
          "answers_en": [
            "I get it now, thank you!",
            "Got it, thanks!"
          ]
        }
      ],
      "closing_zh": "不客气，有问题再来。",
      "closing_en": "You're welcome. Come back if you have questions."
    },
    {
      "id": "2026-11-12-m2",
      "level": 1,
      "title": "Finding the bookshop",
      "role": "路人",
      "goal": "Stop a passer-by and ask the way to a bookshop.",
      "new_words": [
        {
          "word": "前边",
          "english": "ahead; in front"
        },
        {
          "word": "南边",
          "english": "the south side"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么事吗？",
          "partner_en": "Hi, can I help you?",
          "prompt_en": "Ask where the bookshop is.",
          "answers_zh": [
            "请问，书店在哪儿？",
            "书店在哪里？"
          ],
          "answers_en": [
            "Excuse me, where's the bookshop?",
            "Where's the bookshop?"
          ]
        },
        {
          "partner_zh": "书店在前边，火车站的南边。",
          "partner_en": "The bookshop is up ahead, south of the train station.",
          "prompt_en": "Ask if it's far.",
          "answers_zh": [
            "远吗？",
            "离这儿远不远？"
          ],
          "answers_en": [
            "Is it far?",
            "Is it far from here?"
          ]
        },
        {
          "partner_zh": "不远，走五分钟就到了。",
          "partner_en": "Not far, it's a five-minute walk.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "太好了，谢谢你！",
            "谢谢！"
          ],
          "answers_en": [
            "Great, thank you!",
            "Thanks!"
          ]
        }
      ],
      "closing_zh": "不客气！",
      "closing_en": "You're welcome!"
    }
  ]
}
