  "missions": [
    {
      "id": "2026-11-20-m1",
      "level": 2,
      "title": "At the doctor's",
      "role": "医生",
      "goal": "Tell the doctor what's wrong, how long it's been, and ask what to do.",
      "new_words": [
        {
          "word": "头",
          "english": "head"
        },
        {
          "word": "为什么",
          "english": "why"
        },
        {
          "word": "出现",
          "english": "to appear; to start"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，你哪儿不舒服？",
          "partner_en": "Hello, what seems to be the problem?",
          "prompt_en": "Say your head hurts.",
          "answers_zh": [
            "我头疼。",
            "医生，我头很疼。"
          ],
          "answers_en": [
            "I've got a headache.",
            "Doctor, my head really hurts."
          ]
        },
        {
          "partner_zh": "什么时候出现的？",
          "partner_en": "When did it start?",
          "prompt_en": "Say yesterday evening.",
          "answers_zh": [
            "昨天晚上。",
            "昨天晚上就疼了。"
          ],
          "answers_en": [
            "Yesterday evening.",
            "It's hurt since yesterday evening."
          ]
        },
        {
          "partner_zh": "你晚上睡得好吗？",
          "partner_en": "Are you sleeping well?",
          "prompt_en": "Say no, you study until very late.",
          "answers_zh": [
            "不好，我学习到很晚。",
            "睡得很少，我晚上一直学习。"
          ],
          "answers_en": [
            "No, I study till really late.",
            "Not much — I study all evening."
          ]
        },
        {
          "partner_zh": "这就是你头疼的原因。你应该早点睡觉。",
          "partner_en": "That's why your head hurts. You should go to bed earlier.",
          "prompt_en": "Ask why studying late gives you a headache.",
          "answers_zh": [
            "为什么学习到很晚会头疼？",
            "为什么？"
          ],
          "answers_en": [
            "Why does studying late give me a headache?",
            "Why's that?"
          ]
        }
      ],
      "closing_zh": "因为你太累了。多休息，就会好的。",
      "closing_en": "Because you're worn out. Rest more and you'll be fine."
    },
    {
      "id": "2026-11-20-m2",
      "level": 2,
      "title": "Buying trousers",
      "role": "服务员",
      "goal": "Buy a pair of trousers in a clothes shop: find your size and the length.",
      "new_words": [
        {
          "word": "条",
          "english": "(measure word for trousers)"
        },
        {
          "word": "件",
          "english": "(measure word for tops)"
        },
        {
          "word": "长",
          "english": "long"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，你想买什么？",
          "partner_en": "Hello, what are you looking for?",
          "prompt_en": "Say you'd like a pair of trousers.",
          "answers_zh": [
            "我想买一条裤子。",
            "我要一条裤子。"
          ],
          "answers_en": [
            "I'd like to buy some trousers.",
            "I want a pair of trousers."
          ]
        },
        {
          "partner_zh": "这条怎么样？",
          "partner_en": "How about this pair?",
          "prompt_en": "Ask if you can try them on.",
          "answers_zh": [
            "我能试试吗？",
            "可以试一下吗？"
          ],
          "answers_en": [
            "Can I try them on?",
            "Can I try them?"
          ]
        },
        {
          "partner_zh": "可以。怎么样？",
          "partner_en": "Sure. How are they?",
          "prompt_en": "Say they're a bit long.",
          "answers_zh": [
            "有点儿长。",
            "太长了。"
          ],
          "answers_en": [
            "A bit long.",
            "Too long."
          ]
        },
        {
          "partner_zh": "那你试试这条，短一点儿。",
          "partner_en": "Then try this pair — a bit shorter.",
          "prompt_en": "Say these are good, and you'll also take that top.",
          "answers_zh": [
            "这条很好。我还要那件衣服。",
            "这条可以，还有那件，我都要了。"
          ],
          "answers_en": [
            "These are good. I'll take that top too.",
            "These are fine — and that top, I'll take both."
          ]
        }
      ],
      "closing_zh": "好的，一共四百块。",
      "closing_en": "Great, that's four hundred altogether."
    }
  ]
