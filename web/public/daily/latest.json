    {
      "id": "2026-10-31-s1",
      "level": 1,
      "topic": "travel",
      "title_zh": "姐姐的地图",
      "title_en": "My sister's map",
      "paragraphs": [
        ["上", "个", "星期", "，", "我", "和", "姐姐", "去", "北京", "玩", "。", "我们", "想", "去", "一", "个", "老", "地方", "。"],
        ["姐姐", "拿", "着", "地图", "说", "：", "“", "在", "那儿", "！", "”"],
        ["我们", "走", "了", "一", "个", "小时", "，", "还是", "没", "到", "。", "我", "看", "了", "看", "地图", "：", "姐姐", "看", "错", "了", "！"],
        ["姐姐", "说", "：", "“", "对不起", "！", "”"],
        ["我", "说", "：", "“", "没关系", "，", "我们", "走", "了", "很", "多", "路", "，", "也", "很", "好", "！", "”", "我们", "都", "笑", "了", "。"]
      ],
      "translations": [
        "Last week my older sister and I went to Beijing. We wanted to go to an old part of town.",
        "My sister held the map and said: “It’s over there!”",
        "We walked for an hour and still hadn't got there. I looked at the map: my sister had read it wrong!",
        "My sister said: “Sorry!”",
        "I said: “Never mind — we did a lot of walking, and that’s nice too!” We both laughed."
      ],
      "names": ["北京"],
      "new_words": ["地图", "那儿", "没关系"],
      "glossary": [
        { "word": "地图", "english": "map" },
        { "word": "那儿", "english": "there" },
        { "word": "没关系", "english": "never mind; it doesn't matter" },
        { "word": "北京", "english": "Beijing" }
      ]
    },
    {
      "id": "2026-10-31-s2",
      "level": 1,
      "topic": "daily life",
      "title_zh": "十个鸡蛋",
      "title_en": "Ten eggs",
      "paragraphs": [
        ["今天", "早上", "，", "妈妈", "说", "：", "“", "家里", "没有", "鸡蛋", "了", "。", "”", "我", "就", "去", "家", "旁边", "的", "商店", "。", "我", "拿", "了", "钱", "和", "手机", "。"],
        ["那里", "人", "很", "多", "，", "我", "等", "了", "半", "个", "小时", "。"],
        ["最后", "，", "我", "买", "了", "十", "个", "鸡蛋", "。", "回到", "家", "，", "我", "坐下", "来", "休息", "。"],
        ["妈妈", "打开", "一", "看", "：", "一", "个", "也", "没有", "坏", "！", "她", "说", "：", "“", "你", "真", "行", "！", "”", "我", "也", "很", "高兴", "。"]
      ],
      "translations": [
        "This morning Mum said: “We’re out of eggs.” So I went to the shop next to our house. I took some money and my phone.",
        "It was really busy there — I waited half an hour.",
        "In the end I bought ten eggs. When I got home, I sat down for a rest.",
        "Mum opened the box and looked: not a single one was broken! She said: “Well done!” I was really pleased too."
      ],
      "names": [],
      "new_words": ["鸡蛋", "商店", "坐下"],
      "glossary": [
        { "word": "鸡蛋", "english": "egg" },
        { "word": "商店", "english": "shop" },
        { "word": "坐下", "english": "to sit down" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-31-m1",
      "level": 1,
      "title": "Directions with a map",
      "role": "路人",
      "goal": "Show a passer-by your map, ask where the bookshop is and check the way.",
      "new_words": [
        { "word": "地图", "english": "map" },
        { "word": "那儿", "english": "there" },
        { "word": "没关系", "english": "never mind; no problem" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要帮忙吗？",
          "partner_en": "Hi, do you need any help?",
          "prompt_en": "Show the map and ask where this bookshop is.",
          "answers_zh": ["请问，这个书店在哪儿？", "你能在地图上告诉我书店在哪儿吗？"],
          "answers_en": ["Excuse me, where is this bookshop?", "Could you show me on the map where the bookshop is?"]
        },
        {
          "partner_zh": "在那儿，大楼的旁边。",
          "partner_en": "It's there, next to the big building.",
          "prompt_en": "Ask if it's far.",
          "answers_zh": ["远吗？", "走路要多长时间？"],
          "answers_en": ["Is it far?", "How long does it take on foot?"]
        },
        {
          "partner_zh": "不远，走十分钟。",
          "partner_en": "Not far — ten minutes' walk.",
          "prompt_en": "Ask if you go straight on.",
          "answers_zh": ["是一直走吗？", "往前走吗？"],
          "answers_en": ["Do I go straight on?", "Straight ahead?"]
        },
        {
          "partner_zh": "对，一直走，到了路口往左。",
          "partner_en": "Yes, straight on, then left at the junction.",
          "prompt_en": "Repeat it back to check.",
          "answers_zh": ["一直走，路口往左，对吗？", "到路口往左？"],
          "answers_en": ["Straight on, left at the junction — right?", "Left at the junction?"]
        },
        {
          "partner_zh": "对！",
          "partner_en": "That's right!",
          "prompt_en": "Say thank you, and sorry for the trouble.",
          "answers_zh": ["太好了，谢谢你！", "谢谢，麻烦你了！"],
          "answers_en": ["Great, thank you!", "Thanks, sorry for the trouble!"]
        }
      ],
      "closing_zh": "没关系，不客气！",
      "closing_en": "No problem, you're welcome!"
    },
    {
      "id": "2026-10-31-m2",
      "level": 1,
      "title": "At a breakfast stall",
      "role": "老板",
      "goal": "Order eggs and soy milk for breakfast, eat in and pay by phone.",
      "new_words": [
        { "word": "鸡蛋", "english": "egg" },
        { "word": "坐下", "english": "to sit down" }
      ],
      "steps": [
        {
          "partner_zh": "早上好！要什么？",
          "partner_en": "Morning! What would you like?",
          "prompt_en": "Ask for two eggs.",
          "answers_zh": ["我要两个鸡蛋。", "来两个鸡蛋。"],
          "answers_en": ["I'd like two eggs.", "Two eggs, please."]
        },
        {
          "partner_zh": "还要别的吗？",
          "partner_en": "Anything else?",
          "prompt_en": "Say a cup of soy milk too.",
          "answers_zh": ["再要一杯豆浆。", "还要豆浆。"],
          "answers_en": ["A cup of soy milk as well.", "And soy milk."]
        },
        {
          "partner_zh": "在这儿吃吗？",
          "partner_en": "Eating here?",
          "prompt_en": "Say yes, you'll sit down and eat here.",
          "answers_zh": ["对，我坐下吃。", "在这儿吃。"],
          "answers_en": ["Yes, I'll sit down and eat.", "Eating here."]
        },
        {
          "partner_zh": "好，一共七块。",
          "partner_en": "OK, that's seven kuai.",
          "prompt_en": "Say you'll pay by phone.",
          "answers_zh": ["我用手机给。", "可以用手机吗？"],
          "answers_en": ["I'll pay by phone.", "Can I pay by phone?"]
        }
      ],
      "closing_zh": "可以，请坐！",
      "closing_en": "Sure — have a seat!"
    }
  ]
