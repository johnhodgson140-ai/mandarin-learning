  "missions": [
    {
      "id": "2026-11-18-m1",
      "level": 2,
      "title": "First day at the office",
      "role": "公司前台",
      "goal": "Arrive at a company's front desk, say who you're there to see and get directions.",
      "new_words": [
        {
          "word": "公司",
          "english": "company"
        },
        {
          "word": "一直",
          "english": "straight on"
        },
        {
          "word": "第一",
          "english": "first"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，请问你找谁？",
          "partner_en": "Hello, who are you here to see?",
          "prompt_en": "Say you're new and looking for Mr Li.",
          "answers_zh": [
            "我是新来的，我找李先生。",
            "你好，我找李先生。"
          ],
          "answers_en": [
            "I'm new here — I'm looking for Mr Li.",
            "Hello, I'm here to see Mr Li."
          ]
        },
        {
          "partner_zh": "李先生在二楼。",
          "partner_en": "Mr Li is on the second floor.",
          "prompt_en": "Ask how to get there.",
          "answers_zh": [
            "请问怎么走？",
            "二楼怎么走？"
          ],
          "answers_en": [
            "How do I get there?",
            "How do I get to the second floor?"
          ]
        },
        {
          "partner_zh": "上楼以后一直走，第一个门就是。",
          "partner_en": "Go upstairs, then straight on — it's the first door.",
          "prompt_en": "Repeat: straight on, first door.",
          "answers_zh": [
            "一直走，第一个门，对吗？",
            "好，一直走，第一个门。"
          ],
          "answers_en": [
            "Straight on, first door — right?",
            "OK, straight on, first door."
          ]
        },
        {
          "partner_zh": "对。欢迎你来我们公司！",
          "partner_en": "That's right. Welcome to the company!",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "谢谢！",
            "谢谢你！"
          ],
          "answers_en": [
            "Thanks!",
            "Thank you!"
          ]
        }
      ],
      "closing_zh": "不客气，有问题再来找我。",
      "closing_en": "You're welcome. Come and find me if you need anything."
    },
    {
      "id": "2026-11-18-m2",
      "level": 2,
      "title": "Haggling for a vintage jacket",
      "role": "卖家",
      "goal": "Meet an online seller to look at a vintage jacket and get the price down.",
      "new_words": [
        {
          "word": "所有",
          "english": "all"
        },
        {
          "word": "不过",
          "english": "but; however"
        },
        {
          "word": "一定",
          "english": "definitely"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！这就是网上的那个衣服。",
          "partner_en": "Hi! This is the jacket from the listing.",
          "prompt_en": "Say it looks great, and ask if you can try it on.",
          "answers_zh": [
            "很好看！我能试一下吗？",
            "真好看，我可以试试吗？"
          ],
          "answers_en": [
            "It looks great! Can I try it on?",
            "Lovely — can I try it?"
          ]
        },
        {
          "partner_zh": "当然可以。",
          "partner_en": "Of course.",
          "prompt_en": "Say it fits, but it's a bit expensive.",
          "answers_zh": [
            "很合适，不过有点儿贵。",
            "大小很好，不过太贵了。"
          ],
          "answers_en": [
            "It fits well, but it's a bit pricey.",
            "The size is right, but it's too expensive."
          ]
        },
        {
          "partner_zh": "这是很有名的老衣服，三百块不贵。",
          "partner_en": "It's a famous vintage piece — three hundred isn't expensive.",
          "prompt_en": "Say you've only got two hundred and fifty — that's all your money.",
          "answers_zh": [
            "我只有两百五，这是我所有的钱。",
            "两百五行吗？我所有的钱就这么多。"
          ],
          "answers_en": [
            "I've only got 250 — that's all my money.",
            "Would 250 work? That's all I've got."
          ]
        },
        {
          "partner_zh": "好吧，两百五给你。",
          "partner_en": "Fine, 250 it is.",
          "prompt_en": "Thank them and say you'll definitely look after it.",
          "answers_zh": [
            "谢谢！我一定好好穿。",
            "太好了，我一定会好好穿的。"
          ],
          "answers_en": [
            "Thanks! I'll take good care of it.",
            "Brilliant — I'll definitely look after it."
          ]
        }
      ],
      "closing_zh": "好，下次再来看看！",
      "closing_en": "Great — come and have a look again next time!"
    }
