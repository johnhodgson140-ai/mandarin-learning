    {
      "id": "2026-10-12-m1",
      "level": 1,
      "title": "Trying on clothes",
      "role": "店员",
      "goal": "Pick a white top, say your size, try it on, change size and buy it.",
      "new_words": [
        { "word": "试", "english": "to try (on)" },
        { "word": "白", "english": "white" }
      ],
      "steps": [
        {
          "partner_zh": "你好，喜欢什么可以试试。",
          "partner_en": "Hi, feel free to try anything you like.",
          "prompt_en": "Say you like this white one.",
          "answers_zh": ["我喜欢这件白的。", "这件白的很好看。"],
          "answers_en": ["I like this white one.", "This white one looks nice."]
        },
        {
          "partner_zh": "你穿多大的？",
          "partner_en": "What size do you wear?",
          "prompt_en": "Say medium.",
          "answers_zh": ["中号。", "我穿中号。"],
          "answers_en": ["Medium.", "I wear a medium."]
        },
        {
          "partner_zh": "给你，试衣间在那边。",
          "partner_en": "Here you go — the fitting room's over there.",
          "prompt_en": "(After trying it on) Say it's a bit big.",
          "answers_zh": ["有点大。", "这件有点大。"],
          "answers_en": ["It's a bit big.", "This one's a bit big."]
        },
        {
          "partner_zh": "那你试试这件小号的。",
          "partner_en": "Then try this small one.",
          "prompt_en": "Say this one fits just right.",
          "answers_zh": ["这件正好。", "这件很合适。"],
          "answers_en": ["This one's just right.", "This one fits well."]
        },
        {
          "partner_zh": "很好看！要吗？",
          "partner_en": "It looks great! Will you take it?",
          "prompt_en": "Say yes, you'll take it.",
          "answers_zh": ["好，我要了。", "要，多少钱？"],
          "answers_en": ["OK, I'll take it.", "Yes — how much is it?"]
        }
      ],
      "closing_zh": "两百八十块。谢谢！",
      "closing_en": "That's 280 kuai. Thank you!"
    },
    {
      "id": "2026-10-12-m2",
      "level": 1,
      "title": "A hot day",
      "role": "朋友",
      "goal": "Chat with a friend about the heat, compare it with last year and go for a cold drink.",
      "new_words": [
        { "word": "热", "english": "hot" },
        { "word": "去年", "english": "last year" },
        { "word": "高兴", "english": "happy" }
      ],
      "steps": [
        {
          "partner_zh": "今天真热啊！",
          "partner_en": "It's so hot today!",
          "prompt_en": "Agree — it's really hot.",
          "answers_zh": ["是啊，太热了！", "对，非常热。"],
          "answers_en": ["Yeah, it's way too hot!", "Yes, really hot."]
        },
        {
          "partner_zh": "去年这个时候也这么热吗？",
          "partner_en": "Was it this hot at this time last year?",
          "prompt_en": "Say it wasn't this hot last year.",
          "answers_zh": ["去年没有这么热。", "去年不太热。"],
          "answers_en": ["It wasn't this hot last year.", "Last year wasn't too hot."]
        },
        {
          "partner_zh": "我们去喝点冷的吧？",
          "partner_en": "Shall we go and get a cold drink?",
          "prompt_en": "Say great, let's go.",
