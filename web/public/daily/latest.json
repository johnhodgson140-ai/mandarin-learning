    {
      "id": "2026-11-11-s1",
      "level": 1,
      "topic": "football",
      "title_zh": "东边的新地方",
      "title_en": "The new place on the east side",
      "paragraphs": [
        ["我们", "常常", "在", "北边", "的", "学校", "打球", "。", "现在", "，", "我们", "都", "去", "东边", "。"],
        ["东边", "有", "一", "个", "很", "大", "的", "地方", "，", "能", "玩", "球", "，", "也", "很", "干净", "。"],
        ["今天", "，", "很", "多", "人", "来", "了", "。", "我们", "二十", "个", "人", "一起", "打球", "。"],
        ["最后", "，", "我们", "进", "了", "五", "个", "球", "。", "他们", "进", "了", "四", "个", "。", "真", "好", "！"],
        ["我们", "都", "很", "高兴", "，", "明天", "还", "要", "来", "。"]
      ],
      "translations": [
        "We used to play football at the school on the north side. Now we all go to the east side.",
        "There's a big space on the east side where you can play ball, and it's clean too.",
        "Lots of people came today. Twenty of us played together.",
        "In the end we scored five. They scored four. Brilliant!",
        "We were all really happy, and we want to come again tomorrow."
      ],
      "names": [],
      "new_words": ["东边", "北边"],
      "glossary": [
        { "word": "东边", "english": "the east side" },
        { "word": "北边", "english": "the north side" }
      ]
    },
    {
      "id": "2026-11-11-s2",
      "level": 1,
      "topic": "daily life",
      "title_zh": "楼下的包子",
      "title_en": "The buns downstairs",
      "paragraphs": [
        ["我", "家", "楼下", "有", "一", "个", "小", "饭店", "，", "那里", "的", "包子", "很", "好吃", "。"],
        ["今天", "早上", "，", "我", "去", "买", "包子", "。", "门", "上", "有", "很", "多", "汉字", "，", "我", "都", "认识", "！"],
        ["我", "说", "：", "“", "我", "要", "四", "个", "包子", "。", "”", "那", "个", "老", "先生", "说", "：", "“", "你", "的", "中文", "很", "好", "！", "”"],
        ["我", "说", "：", "“", "谢谢", "！", "”", "他", "说", "：", "“", "不客气", "！", "下次", "再", "来", "。", "”"],
        ["我", "拿", "着", "包子", "回家", "，", "和", "家人", "一起", "吃", "了", "早饭", "。"]
      ],
      "translations": [
        "There's a little restaurant downstairs from my flat, and its buns are delicious.",
        "This morning I went to buy some. There were lots of Chinese characters on the door, and I knew them all!",
        "I said: “Four buns, please.” The old man said: “Your Chinese is very good!”",
        "I said: “Thank you!” He said: “You’re welcome! Come again.”",
        "I took the buns home and had breakfast with my family."
      ],
      "names": [],
      "new_words": ["包子", "汉字", "不客气"],
      "glossary": [
        { "word": "包子", "english": "steamed bun" },
        { "word": "汉字", "english": "Chinese character" },
        { "word": "不客气", "english": "you're welcome" }
      ]
    }
