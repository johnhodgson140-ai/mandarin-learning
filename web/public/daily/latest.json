  "missions": [
    {
      "id": "2026-11-14-m1",
      "level": 1,
      "title": "Borrowing a phone",
      "role": "朋友",
      "goal": "Your phone has died. Ask your friend if you can use theirs to call home.",
      "new_words": [
        {
          "word": "一下儿",
          "english": "for a moment"
        },
        {
          "word": "可以",
          "english": "can; may"
        },
        {
          "word": "啊",
          "english": "(softens a reply)"
        }
      ],
      "steps": [
        {
          "partner_zh": "你怎么了？",
          "partner_en": "What's up?",
          "prompt_en": "Say your phone has no power.",
          "answers_zh": [
            "我的手机没电了。",
            "手机没电了。"
          ],
          "answers_en": [
            "My phone's died.",
            "My phone's out of battery."
          ]
        },
        {
          "partner_zh": "那怎么办？",
          "partner_en": "So what will you do?",
          "prompt_en": "Ask if you can use their phone for a moment.",
          "answers_zh": [
            "我可以用一下儿你的手机吗？",
            "你的手机可以给我用一下儿吗？"
          ],
          "answers_en": [
            "Can I use your phone for a sec?",
            "Could I borrow your phone for a moment?"
          ]
        },
        {
          "partner_zh": "可以啊。你给谁打电话？",
          "partner_en": "Sure. Who are you calling?",
          "prompt_en": "Say your mum.",
          "answers_zh": [
            "给我妈妈打。",
            "我妈妈。"
          ],
          "answers_en": [
            "My mum.",
            "My mum."
          ]
        },
        {
          "partner_zh": "给你。",
          "partner_en": "Here you go.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "谢谢你！",
            "谢谢，马上给你。"
          ],
          "answers_en": [
            "Thank you!",
            "Thanks, I'll give it right back."
          ]
        }
      ],
      "closing_zh": "不客气。",
      "closing_en": "No problem."
    },
    {
      "id": "2026-11-14-m2",
      "level": 1,
      "title": "Joining a game in the park",
      "role": "打球的人",
      "goal": "Some people are playing football in the park. Ask if you can join in.",
      "new_words": [
        {
          "word": "可以",
          "english": "can; may"
        },
        {
          "word": "已经",
          "english": "already"
        }
      ],
      "steps": [
        {
          "partner_zh": "你也想打球吗？",
          "partner_en": "Do you want to play too?",
          "prompt_en": "Say yes, and ask if you can join.",
          "answers_zh": [
            "想！我可以来吗？",
            "我可以和你们一起打吗？"
          ],
          "answers_en": [
            "Yes! Can I join?",
            "Can I play with you?"
          ]
        },
        {
          "partner_zh": "可以。你会打球吗？",
          "partner_en": "Sure. Can you play?",
          "prompt_en": "Say a little, but you love it.",
          "answers_zh": [
            "会一点儿，我很爱打球。",
            "会一点儿。"
          ],
          "answers_en": [
            "A bit — I love playing.",
            "A little."
          ]
        },
        {
          "partner_zh": "好。我们已经打了半天了，二比一。",
          "partner_en": "Great. We've been playing for ages already — it's two-one.",
          "prompt_en": "Ask which side you're on.",
          "answers_zh": [
            "我在哪边？",
            "我和谁一起？"
          ],
          "answers_en": [
            "Which side am I on?",
            "Who am I with?"
          ]
        },
        {
          "partner_zh": "你在我们这边。",
          "partner_en": "You're on our side.",
          "prompt_en": "Say great, let's go.",
          "answers_zh": [
            "好，走吧！",
            "好的，来吧！"
          ],
          "answers_en": [
            "Great, let's go!",
            "OK, come on!"
          ]
        }
      ],
      "closing_zh": "来吧！",
      "closing_en": "Come on then!"
    }
  ]
