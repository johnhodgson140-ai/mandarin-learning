    {
      "id": "2026-10-16-s1",
      "level": 1,
      "topic": "daily life",
      "title_zh": "风很大",
      "title_en": "A windy day",
      "paragraphs": [
        ["今天", "下午", "风", "很", "大", "。", "我", "在", "家里", "读", "书", "。"],
        ["门", "开", "了", "，", "风", "进", "来", "了", "。", "我", "的", "书", "都", "飞", "起来", "了", "！"],
        ["我", "马上", "去", "关", "门", "。", "我", "再", "去", "找", "我", "的", "书", "，", "找", "了", "半", "个", "小时", "，", "最后", "都", "找到", "了", "。"],
        ["晚上", "，", "风", "不", "大", "了", "。", "我", "打开", "门", "，", "出去", "走", "了", "走", "。"],
        ["我", "走", "了", "一", "个", "小时", "，", "就", "回家", "睡觉", "了", "。"]
      ],
      "translations": [
        "This afternoon it was really windy. I was at home reading.",
        "The door blew open and the wind came in. My books went flying!",
        "I rushed to close the door. After that I went to find my books. It took half an hour, but in the end I found them all.",
        "In the evening the wind died down. I opened the door and went out for a walk.",
        "I walked for an hour, then went home to bed."
      ],
      "names": [],
      "new_words": ["风", "关", "打开"],
      "glossary": [
        { "word": "风", "english": "wind" },
        { "word": "关", "english": "to close" },
        { "word": "打开", "english": "to open" }
      ]
    },
    {
      "id": "2026-10-16-s2",
      "level": 1,
      "topic": "archive fashion",
      "title_zh": "我哥的包",
      "title_en": "My brother's bag",
      "paragraphs": [
        ["我", "哥", "有", "很", "多", "老", "东西", "。"],
        ["有", "一", "天", "，", "我", "在", "他", "家里", "看到", "了", "一", "个", "白", "包", "。", "这", "个", "包", "是", "二十", "年", "前", "的", "。"],
        ["包", "很", "老", "了", "，", "我", "很", "喜欢", "。", "我", "问", "我", "哥", "：", "“", "我", "能", "试", "试", "吗", "？", "”", "他", "说", "：", "“", "你", "拿", "去", "吧", "！", "”"],
        ["现在", "，", "我", "出去", "都", "拿", "着", "这", "个", "包", "。", "朋友", "们", "都", "问", "我", "：", "“", "在", "哪里", "买", "的", "？", "”"],
        ["我", "笑", "着", "回答", "：", "“", "我", "哥", "送", "的", "！", "”"]
      ],
      "translations": [
        "My older brother has lots of old things.",
        "One day I saw a white bag at his place. The bag is twenty years old.",
        "The bag is really old, and I love it. I asked my brother: “Can I try it?” He said: “Take it!”",
        "Now I take this bag whenever I go out. My friends all ask me: “Where did you buy it?”",
        "I answer with a smile: “My brother gave it to me!”"
      ],
      "names": [],
      "new_words": ["哥", "回答"],
      "glossary": [
        { "word": "哥", "english": "older brother" },
        { "word": "回答", "english": "to answer" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-16-m1",
      "level": 1,
      "title": "A window that won't close",
      "role": "前台",
      "goal": "Call hotel reception: the window won't close, it's windy and cold, and you accept a new room.",
      "new_words": [
        { "word": "关", "english": "to close" },
        { "word": "风", "english": "wind" },
        { "word": "打开", "english": "to open" }
      ],
      "steps": [
        {
          "partner_zh": "你好，这里是前台。",
          "partner_en": "Hello, this is reception.",
          "prompt_en": "Say the window in your room won't close.",
          "answers_zh": ["我房间的窗户关不上。", "窗户关不了。"],
          "answers_en": ["The window in my room won't close.", "The window won't shut."]
        },
        {
          "partner_zh": "几号房间？",
          "partner_en": "Which room?",
          "prompt_en": "Say room 805.",
          "answers_zh": ["八零五。", "八零五号房间。"],
          "answers_en": ["805.", "Room 805."]
        },
        {
          "partner_zh": "好的，我们马上找人去看。",
          "partner_en": "OK, we'll send someone to look right away.",
          "prompt_en": "Say it's very windy and cold.",
          "answers_zh": ["风很大，很冷。", "房间里很冷。"],
          "answers_en": ["It's really windy and cold.", "It's cold in the room."]
        },
        {
          "partner_zh": "不好意思。要不要给您换一个房间？",
          "partner_en": "Sorry about that. Would you like to change rooms?",
          "prompt_en": "Say yes, please.",
          "answers_zh": ["好的，谢谢。", "可以，麻烦你了。"],
          "answers_en": ["Yes, thank you.", "Yes please, sorry for the trouble."]
        },
        {
          "partner_zh": "八零七的门我们给您打开了。",
          "partner_en": "We've opened the door of room 807 for you.",
          "prompt_en": "Say OK, you'll go now.",
          "answers_zh": ["好的，我马上过去。", "好，我现在去。"],
          "answers_en": ["OK, I'll go straight over.", "OK, I'm going now."]
        }
      ],
      "closing_zh": "不客气，晚安！",
      "closing_en": "You're welcome, good night!"
    },
    {
      "id": "2026-10-16-m2",
      "level": 1,
      "title": "Visiting a sick friend",
      "role": "朋友",
      "goal": "Visit a friend who's ill: ask how they are, give them fruit and say when you'll come back.",
      "new_words": [
        { "word": "累", "english": "tired" },
        { "word": "回去", "english": "to go back" }
      ],
      "steps": [
        {
          "partner_zh": "你来了！",
          "partner_en": "You came!",
          "prompt_en": "Ask how they're feeling.",
          "answers_zh": ["你好点了吗？", "你怎么样？"],
          "answers_en": ["Are you feeling better?", "How are you?"]
        },
        {
          "partner_zh": "好多了，就是有点累。",
          "partner_en": "Much better, just a bit tired.",
          "prompt_en": "Tell them to rest well.",
          "answers_zh": ["你好好休息。", "那你多休息。"],
          "answers_en": ["Get some good rest.", "Then rest as much as you can."]
        },
        {
          "partner_zh": "你给我带了什么？",
          "partner_en": "What have you brought me?",
          "prompt_en": "Say some fruit.",
          "answers_zh": ["我给你买了水果。", "一些水果。"],
          "answers_en": ["I bought you some fruit.", "Some fruit."]
        },
        {
          "partner_zh": "谢谢！你今天不用工作吗？",
          "partner_en": "Thanks! Don't you have to work today?",
          "prompt_en": "Say you have to go back to work this afternoon.",
          "answers_zh": ["我下午还要回去工作。", "下午要回去。"],
          "answers_en": ["I have to go back to work this afternoon.", "I'm going back this afternoon."]
        },
        {
          "partner_zh": "那你快回去吧。",
          "partner_en": "Then you'd better get going.",
          "prompt_en": "Say OK, you'll come again tomorrow.",
          "answers_zh": ["好，我明天再来看你。", "好的，明天见！"],
          "answers_en": ["OK, I'll come and see you again tomorrow.", "OK, see you tomorrow!"]
        }
      ],
      "closing_zh": "好，谢谢你来看我！",
      "closing_en": "OK, thanks for coming to see me!"
    }
  ]
}
