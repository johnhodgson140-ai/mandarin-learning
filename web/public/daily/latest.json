  "missions": [
    {
      "id": "2026-10-21-m1",
      "level": 1,
      "title": "Planning a day trip",
      "role": "前台",
      "goal": "Ask hotel reception about tomorrow's weather and how to get to the mountain in the south.",
      "new_words": [
        { "word": "天气", "english": "weather" },
        { "word": "南", "english": "south" },
        { "word": "最好", "english": "it's best to" }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么可以帮您？",
          "partner_en": "Hello, how can I help?",
          "prompt_en": "Ask what the weather will be like tomorrow.",
          "answers_zh": ["明天天气怎么样？", "请问明天天气好吗？"],
          "answers_en": ["What will the weather be like tomorrow?", "Excuse me, will the weather be good tomorrow?"]
        },
        {
          "partner_zh": "明天天气很好，不冷也不热。",
          "partner_en": "The weather will be lovely tomorrow — not cold, not hot.",
          "prompt_en": "Say you want to go to the mountain in the south.",
          "answers_zh": ["我想去南边的山。", "我想去南山玩。"],
          "answers_en": ["I'd like to go to the mountain in the south.", "I want to go to Nanshan."]
        },
        {
          "partner_zh": "那最好早上去，下午人很多。",
          "partner_en": "Then it's best to go in the morning — it's busy in the afternoon.",
          "prompt_en": "Ask how to get there.",
          "answers_zh": ["怎么去？", "坐什么车去？"],
          "answers_en": ["How do I get there?", "What should I take to get there?"]
        },
        {
          "partner_zh": "坐地铁到南站，再坐车。",
          "partner_en": "Take the metro to South Station, then take a bus.",
          "prompt_en": "Ask how long the journey takes.",
          "answers_zh": ["路上要多长时间？", "要多长时间？"],
          "answers_en": ["How long is the journey?", "How long does it take?"]
        },
        {
          "partner_zh": "一个小时左右。",
          "partner_en": "About an hour.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["好的，谢谢！", "谢谢你！"],
          "answers_en": ["OK, thanks!", "Thank you!"]
        }
      ],
      "closing_zh": "不客气，祝您玩得开心！",
      "closing_en": "You're welcome — have fun!"
    },
    {
      "id": "2026-10-21-m2",
      "level": 1,
      "title": "Late to meet a friend",
      "role": "朋友",
      "goal": "Apologise for being late, explain why, go into the restaurant and offer to pay.",
      "new_words": [
        { "word": "对不起", "english": "sorry" },
        { "word": "路上", "english": "on the way" },
        { "word": "没什么", "english": "it's nothing; never mind" }
      ],
      "steps": [
        {
          "partner_zh": "你怎么现在才来？",
          "partner_en": "Why are you only just getting here?",
          "prompt_en": "Say sorry, you're late.",
          "answers_zh": ["对不起，我来晚了。", "不好意思，我晚了。"],
          "answers_en": ["Sorry, I'm late.", "Sorry I'm late."]
        },
        {
          "partner_zh": "怎么了？",
          "partner_en": "What happened?",
          "prompt_en": "Say there was too much traffic on the way.",
          "answers_zh": ["路上车太多了。", "路上堵车了。"],
          "answers_en": ["There was too much traffic on the way.", "I got stuck in traffic."]
        },
        {
          "partner_zh": "没什么，我也刚到。",
          "partner_en": "Never mind, I've only just arrived too.",
          "prompt_en": "Suggest going in.",
          "answers_zh": ["我们进去吧。", "走，进去吧。"],
          "answers_en": ["Let's go in.", "Come on, let's go in."]
        },
        {
          "partner_zh": "好。你想吃什么？",
          "partner_en": "OK. What do you want to eat?",
          "prompt_en": "Say you're hungry and anything is fine.",
          "answers_zh": ["我很饿，什么都行。", "随便，我饿了。"],
          "answers_en": ["I'm starving — anything's fine.", "Whatever, I'm hungry."]
        },
        {
          "partner_zh": "那我们点几个菜吧。",
          "partner_en": "Then let's order a few dishes.",
          "prompt_en": "Say OK — it's your treat today.",
          "answers_zh": ["好，今天我请你。", "好的，今天我来请。"],
          "answers_en": ["OK, my treat today.", "Sure, today's on me."]
        }
      ],
      "closing_zh": "太好了，谢谢！",
      "closing_en": "Great, thanks!"
    }
  ]
