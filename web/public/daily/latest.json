  "missions": [
    {
      "id": "2026-10-27-m1",
      "level": 1,
      "title": "Saying goodbye",
      "role": "朋友",
      "goal": "Say goodbye to a friend before you fly home: when you're leaving, and that you'll come back next year.",
      "new_words": [
        { "word": "明年", "english": "next year" },
        { "word": "再见", "english": "goodbye" },
        { "word": "妹", "english": "younger sister" }
      ],
      "steps": [
        {
          "partner_zh": "你明天就回去了？",
          "partner_en": "You're going home tomorrow?",
          "prompt_en": "Say yes, tomorrow at midday.",
          "answers_zh": ["是的，明天中午走。", "对，明天中午的飞机。"],
          "answers_en": ["Yes, I leave tomorrow at midday.", "Yes, my flight's at midday tomorrow."]
        },
        {
          "partner_zh": "我们会想你的。",
          "partner_en": "We'll miss you.",
          "prompt_en": "Say you'll miss them too.",
          "answers_zh": ["我也会想你们的。", "我也会想你们。"],
          "answers_en": ["I'll miss you all too.", "I'll miss you too."]
        },
        {
          "partner_zh": "明年还来吗？",
          "partner_en": "Will you come back next year?",
          "prompt_en": "Say yes, you want to come back next year.",
          "answers_zh": ["明年我还想来。", "一定来！"],
          "answers_en": ["I want to come back next year.", "Definitely!"]
        },
        {
          "partner_zh": "太好了！我妹也很喜欢你。",
          "partner_en": "Great! My little sister really likes you too.",
          "prompt_en": "Ask them to thank her for you.",
          "answers_zh": ["也谢谢她！", "替我谢谢她！"],
          "answers_en": ["Thank her too!", "Say thanks to her for me!"]
        },
        {
          "partner_zh": "好，路上小心。再见！",
          "partner_en": "OK, have a safe trip. Goodbye!",
          "prompt_en": "Say goodbye.",
          "answers_zh": ["谢谢，再见！", "再见！"],
          "answers_en": ["Thanks, bye!", "Goodbye!"]
        }
      ],
      "closing_zh": "再见，明年见！",
      "closing_en": "Bye — see you next year!"
    },
