  "missions": [
    {
      "id": "2026-11-15-m1",
      "level": 2,
      "title": "Swapping a jacket",
      "role": "服务员",
      "goal": "Take a jacket back to the shop because it's too small, and swap it for a bigger one.",
      "new_words": [
        {
          "word": "问题",
          "english": "problem"
        },
        {
          "word": "因为",
          "english": "because"
        },
        {
          "word": "只",
          "english": "only"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！有什么问题吗？",
          "partner_en": "Hello! Is there a problem?",
          "prompt_en": "Say you bought this yesterday, and it's too small.",
          "answers_zh": [
            "我昨天买了这个，太小了。",
            "这个衣服太小了。"
          ],
          "answers_en": [
            "I bought this yesterday, and it's too small.",
            "This is too small."
          ]
        },
        {
          "partner_zh": "你要换一个大的吗？",
          "partner_en": "Would you like to swap it for a bigger one?",
          "prompt_en": "Say yes, because you like it a lot.",
          "answers_zh": [
            "要，因为我很喜欢它。",
            "对，我很喜欢这个。"
          ],
          "answers_en": [
            "Yes, because I really like it.",
            "Yes, I really like this one."
          ]
        },
        {
          "partner_zh": "对不起，白的只有小的了。黑的可以吗？",
          "partner_en": "Sorry, the white one only comes in small now. Is black OK?",
          "prompt_en": "Ask if you can try the black one on.",
          "answers_zh": [
            "我能试一下儿吗？",
            "我先试试黑的。"
          ],
          "answers_en": [
            "Can I try it on?",
            "Let me try the black one first."
          ]
        },
        {
          "partner_zh": "好的，这边请。",
          "partner_en": "Sure, this way please.",
          "prompt_en": "Say it fits — you'll take it.",
          "answers_zh": [
            "这个很好，我要了。",
            "大小很好，就要这个。"
          ],
          "answers_en": [
            "This one's great, I'll take it.",
            "The size is right — I'll have this one."
          ]
        }
      ],
      "closing_zh": "好的，没问题！",
      "closing_en": "Great, no problem!"
    },
    {
      "id": "2026-11-15-m2",
      "level": 2,
      "title": "Running late",
      "role": "朋友",
      "goal": "Your friend calls because you're late for dinner. Apologise, explain and say when you'll arrive.",
      "new_words": [
        {
          "word": "又",
          "english": "again"
        },
        {
          "word": "如果",
          "english": "if"
        }
      ],
      "steps": [
        {
          "partner_zh": "你在哪儿？你又晚了！",
          "partner_en": "Where are you? You're late again!",
          "prompt_en": "Say sorry, you're on the bus.",
          "answers_zh": [
            "对不起，我在公共汽车上。",
            "不好意思，我在车上。"
          ],
          "answers_en": [
            "Sorry, I'm on the bus.",
            "Sorry, I'm on my way."
          ]
        },
        {
          "partner_zh": "你几点能到？",
          "partner_en": "What time can you get here?",
          "prompt_en": "Say in about twenty minutes.",
          "answers_zh": [
            "二十分钟后到。",
            "大概二十分钟。"
          ],
          "answers_en": [
            "I'll be there in twenty minutes.",
            "About twenty minutes."
          ]
        },
        {
          "partner_zh": "如果你饿了，我们先点菜吧？",
          "partner_en": "If you're hungry, shall we order first?",
          "prompt_en": "Say yes, order first, you'll eat anything.",
          "answers_zh": [
            "好，你们先点吧，我什么都吃。",
            "好的，先点菜吧。"
          ],
          "answers_en": [
            "Sure, go ahead and order — I'll eat anything.",
            "OK, order first."
          ]
        },
        {
          "partner_zh": "好，快点来！",
          "partner_en": "OK, hurry up!",
          "prompt_en": "Say you'll be right there.",
          "answers_zh": [
            "好，马上到！",
            "我马上来。"
          ],
          "answers_en": [
            "OK, nearly there!",
            "I'll be right there."
          ]
        }
      ],
      "closing_zh": "一会儿见！",
      "closing_en": "See you soon!"
    }
  ]
