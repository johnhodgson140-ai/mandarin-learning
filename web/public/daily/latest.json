  "missions": [
    {
      "id": "2026-11-24-m1",
      "level": 2,
      "title": "A job interview",
      "role": "公司的人",
      "goal": "Answer questions in a short interview for a part-time job at a company.",
      "new_words": [
        {
          "word": "要求",
          "english": "requirement; to require"
        },
        {
          "word": "接受",
          "english": "to accept"
        },
        {
          "word": "进入",
          "english": "to enter; to join"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，请坐。请你介绍一下自己。",
          "partner_en": "Hello, have a seat. Please introduce yourself.",
          "prompt_en": "Say your name and that you're a university student.",
          "answers_zh": [
            "我叫李明，是大学生。",
            "我是李明，我在大学学习。"
          ],
          "answers_en": [
            "I'm Li Ming, a university student.",
            "I'm Li Ming, I study at university."
          ]
        },
        {
          "partner_zh": "你为什么想进入我们公司？",
          "partner_en": "Why do you want to join our company?",
          "prompt_en": "Say because it's well-known and you want to learn.",
          "answers_zh": [
            "因为公司很有名，我想多学习。",
            "因为我想在这里学习。"
          ],
          "answers_en": [
            "Because the company is well-known and I want to learn.",
            "Because I want to learn here."
          ]
        },
        {
          "partner_zh": "我们的要求很高，每天要工作八个小时。",
          "partner_en": "Our standards are high — eight hours a day.",
          "prompt_en": "Say no problem, you're not afraid of being tired.",
          "answers_zh": [
            "没问题，我不怕累。",
            "可以，我能工作八个小时。"
          ],
          "answers_en": [
            "No problem, I don't mind hard work.",
            "That's fine, I can do eight hours."
          ]
        },
        {
          "partner_zh": "好，我们接受你。下个星期来上班吧。",
          "partner_en": "Good — we'll take you. Start next week.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "太好了，谢谢！",
            "谢谢您！下个星期见。"
          ],
          "answers_en": [
            "Brilliant, thank you!",
            "Thank you! See you next week."
          ]
        }
      ],
      "closing_zh": "不客气，下个星期见。",
      "closing_en": "You're welcome. See you next week."
    },
    {
      "id": "2026-11-24-m2",
      "level": 2,
      "title": "Where are you?",
      "role": "朋友",
      "goal": "You're waiting for your friend outside the cinema. Call to find out where they are.",
      "new_words": [
        {
          "word": "分钟",
          "english": "minute"
        },
        {
          "word": "刚",
          "english": "just"
        },
        {
          "word": "有人",
          "english": "someone"
        }
      ],
      "steps": [
        {
          "partner_zh": "喂？",
          "partner_en": "Hello?",
          "prompt_en": "Ask where they are — you're at the cinema door.",
          "answers_zh": [
            "你在哪儿？我在电影院门口。",
            "我到了，你在哪儿？"
          ],
          "answers_en": [
            "Where are you? I'm at the cinema entrance.",
            "I'm here — where are you?"
          ]
        },
        {
          "partner_zh": "对不起，我刚下车。",
          "partner_en": "Sorry, I've just got off the bus.",
          "prompt_en": "Ask how many minutes until they arrive.",
          "answers_zh": [
            "你几分钟能到？",
            "还要多少分钟？"
          ],
          "answers_en": [
            "How many minutes till you get here?",
            "How many more minutes?"
          ]
        },
        {
          "partner_zh": "五分钟。电影开始了吗？",
          "partner_en": "Five minutes. Has the film started?",
          "prompt_en": "Say not yet, but people are already going in.",
          "answers_zh": [
            "还没有，可是已经有人进去了。",
            "没有，有人已经进去了。"
          ],
          "answers_en": [
            "Not yet, but people are already going in.",
            "No, but some people have gone in."
          ]
        },
        {
          "partner_zh": "好，我马上到！",
          "partner_en": "OK, I'll be right there!",
          "prompt_en": "Say OK, you'll wait at the door.",
          "answers_zh": [
            "好，我在门口等你。",
            "好的，快点！"
          ],
          "answers_en": [
            "OK, I'll wait for you at the door.",
            "OK, hurry up!"
          ]
        }
      ],
      "closing_zh": "一会儿见！",
      "closing_en": "See you in a bit!"
    }
  ]
