  "missions": [
    {
      "id": "2026-11-19-m1",
      "level": 2,
      "title": "Checking into a hotel",
      "role": "前台",
      "goal": "Check into your hotel, ask about breakfast and what to do with your key.",
      "new_words": [
        {
          "word": "必须",
          "english": "must"
        },
        {
          "word": "然后",
          "english": "then; after that"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！你叫什么名字？",
          "partner_en": "Hello! What's your name?",
          "prompt_en": "Give your name and say you've booked a room.",
          "answers_zh": [
            "我叫李明，我有一个房间。",
            "你好，我叫李明。"
          ],
          "answers_en": [
            "I'm Li Ming, I've got a room booked.",
            "Hello, my name's Li Ming."
          ]
        },
        {
          "partner_zh": "好的。你住几天？",
          "partner_en": "Great. How many nights are you staying?",
          "prompt_en": "Say three nights.",
          "answers_zh": [
            "三天。",
            "住三天。"
          ],
          "answers_en": [
            "Three nights.",
            "Staying three nights."
          ]
        },
        {
          "partner_zh": "你的房间在五楼。你必须先上楼，然后向右走。",
          "partner_en": "Your room's on the fifth floor. Go upstairs first, then turn right.",
          "prompt_en": "Ask what time breakfast is.",
          "answers_zh": [
            "早饭几点？",
            "请问，早饭是几点？"
          ],
          "answers_en": [
            "What time is breakfast?",
            "Excuse me, what time is breakfast?"
          ]
        },
        {
          "partner_zh": "早上七点到九点，在一楼。",
          "partner_en": "Seven to nine in the morning, on the ground floor.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "好，谢谢！",
            "知道了，谢谢你！"
          ],
          "answers_en": [
            "OK, thanks!",
            "Got it, thank you!"
          ]
        }
      ],
      "closing_zh": "不客气，祝你在北京玩儿得好！",
      "closing_en": "You're welcome — enjoy Beijing!"
    },
    {
      "id": "2026-11-19-m2",
      "level": 2,
      "title": "Off sick",
      "role": "老师",
      "goal": "Call your teacher to say you're ill and won't be in class today.",
      "new_words": [
        {
          "word": "事情",
          "english": "matter; thing"
        },
        {
          "word": "感觉",
          "english": "to feel"
        },
        {
          "word": "而且",
          "english": "and what's more"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么事情吗？",
          "partner_en": "Hello, what can I do for you?",
          "prompt_en": "Say you're ill today.",
          "answers_zh": [
            "老师，我今天病了。",
            "老师，我身体不好。"
          ],
          "answers_en": [
            "Teacher, I'm ill today.",
            "Teacher, I'm not feeling well."
          ]
        },
        {
          "partner_zh": "你感觉怎么样？",
          "partner_en": "How are you feeling?",
          "prompt_en": "Say you feel cold, and your head hurts too.",
          "answers_zh": [
            "我感觉很冷，而且头很疼。",
            "很冷，而且头疼。"
          ],
          "answers_en": [
            "I feel really cold, and my head hurts too.",
            "Cold, and I've got a headache."
          ]
        },
        {
          "partner_zh": "那你今天别来上课了，去医院看看吧。",
          "partner_en": "Then don't come to class today — go and see a doctor.",
          "prompt_en": "Say OK, you'll go to the hospital.",
          "answers_zh": [
            "好，我去医院。",
            "好的，我马上去医院。"
          ],
          "answers_en": [
            "OK, I'll go to the hospital.",
            "OK, I'll go to the hospital now."
          ]
        },
        {
          "partner_zh": "好好休息。",
          "partner_en": "Get some good rest.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "谢谢老师！",
            "谢谢，明天见。"
          ],
          "answers_en": [
            "Thank you!",
            "Thanks, see you tomorrow."
          ]
        }
      ],
      "closing_zh": "不客气，明天见。",
      "closing_en": "You're welcome. See you tomorrow."
    }
  ]
