  "missions": [
    {
      "id": "2026-10-15-m1",
      "level": 1,
      "title": "Booking a flight",
      "role": "工作人员",
      "goal": "Book a flight to Beijing: choose the day and a morning flight, and ask for a cheaper option.",
      "new_words": [
        { "word": "飞机", "english": "plane" },
        { "word": "早上", "english": "morning" }
      ],
      "steps": [
        {
          "partner_zh": "你好，您要去哪里？",
          "partner_en": "Hello, where would you like to go?",
          "prompt_en": "Say you want to go to Beijing next Friday.",
          "answers_zh": ["我想下个星期五去北京。", "下星期五，去北京。"],
          "answers_en": ["I'd like to go to Beijing next Friday.", "Next Friday, to Beijing."]
        },
        {
          "partner_zh": "坐飞机还是坐火车？",
          "partner_en": "By plane or by train?",
          "prompt_en": "Say by plane.",
          "answers_zh": ["坐飞机。", "我想坐飞机。"],
          "answers_en": ["By plane.", "I'd like to fly."]
        },
        {
          "partner_zh": "早上的还是晚上的？",
          "partner_en": "Morning or evening?",
          "prompt_en": "Say a morning one.",
          "answers_zh": ["早上的。", "早上的吧。"],
          "answers_en": ["Morning.", "A morning one, please."]
        },
        {
          "partner_zh": "早上八点有一班，一千二。",
          "partner_en": "There's one at eight in the morning — 1,200.",
          "prompt_en": "Ask if there's a cheaper one.",
          "answers_zh": ["有便宜一点的吗？", "还有更便宜的吗？"],
          "answers_en": ["Is there a cheaper one?", "Anything cheaper?"]
        },
        {
          "partner_zh": "十点那班九百。",
          "partner_en": "The ten o'clock one is 900.",
          "prompt_en": "Say you'll take the ten o'clock flight.",
          "answers_zh": ["好，我要十点那班。", "就十点的吧。"],
          "answers_en": ["OK, I'll take the ten o'clock one.", "The ten o'clock, then."]
        }
      ],
      "closing_zh": "好的，给您订好了。",
      "closing_en": "OK, you're booked."
    },
    {
      "id": "2026-10-15-m2",
      "level": 1,
      "title": "Viewing a flat",
      "role": "中介",
      "goal": "Ask an agent about a flat: rooms, rent, whether it's cold in winter and how far the metro is.",
      "new_words": [
        { "word": "房子", "english": "house; flat" },
        { "word": "冷", "english": "cold" },
        { "word": "回答", "english": "answer; to answer" }
      ],
      "steps": [
        {
          "partner_zh": "你好，这就是那个房子。",
          "partner_en": "Hi, this is the flat.",
          "prompt_en": "Ask how many rooms there are.",
          "answers_zh": ["有几个房间？", "几个房间？"],
          "answers_en": ["How many rooms are there?", "How many rooms?"]
        },
        {
          "partner_zh": "两个房间，一个厨房。",
          "partner_en": "Two rooms and a kitchen.",
          "prompt_en": "Ask how much it is a month.",
          "answers_zh": ["一个月多少钱？", "房租多少？"],
          "answers_en": ["How much is it a month?", "What's the rent?"]
        },
        {
          "partner_zh": "三千五一个月。",
          "partner_en": "3,500 a month.",
          "prompt_en": "Ask if it's cold in winter.",
          "answers_zh": ["冬天冷不冷？", "冬天这里冷吗？"],
          "answers_en": ["Is it cold in winter?", "Does it get cold here in winter?"]
        },
        {
          "partner_zh": "不冷，有暖气。",
          "partner_en": "No, there's heating.",
          "prompt_en": "Ask if the metro station is far.",
          "answers_zh": ["离地铁远吗？", "地铁站远不远？"],
          "answers_en": ["Is it far from the metro?", "Is the metro station far?"]
        },
        {
          "partner_zh": "很近，走五分钟。你要吗？",
          "partner_en": "Very close — five minutes' walk. Do you want it?",
          "prompt_en": "Say you like it and will give an answer tomorrow.",
          "answers_zh": ["我很喜欢，明天给你回答。", "我想想，明天告诉你。"],
          "answers_en": ["I really like it — I'll give you an answer tomorrow.", "Let me think, I'll tell you tomorrow."]
        }
      ],
      "closing_zh": "好的，等你电话！",
      "closing_en": "OK, I'll wait for your call!"
    }
  ]
