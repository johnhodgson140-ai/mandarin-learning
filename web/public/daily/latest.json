      "goal": "Say hello to your friend's boyfriend, talk about your classes and agree to have dinner sometime.",
      "new_words": [
        { "word": "男朋友", "english": "boyfriend" },
        { "word": "上课", "english": "to have class" }
      ],
      "steps": [
        {
          "partner_zh": "这是我男朋友，小李。",
          "partner_en": "This is my boyfriend, Xiao Li.",
          "prompt_en": "Say hello, nice to meet you.",
          "answers_zh": ["你好，认识你很高兴！", "你好，很高兴认识你。"],
          "answers_en": ["Hi, great to meet you!", "Hello, nice to meet you."]
        },
        {
          "partner_zh": "你也是学生吗？",
          "partner_en": "Are you a student too?",
          "prompt_en": "Say yes, you have classes in the evening.",
          "answers_zh": ["是的，我晚上上课。", "对，我晚上去上课。"],
          "answers_en": ["Yes, I have classes in the evening.", "Yes, I go to class in the evenings."]
        },
        {
          "partner_zh": "你学什么？",
          "partner_en": "What do you study?",
          "prompt_en": "Say Chinese.",
          "answers_zh": ["我学中文。", "学中文。"],
          "answers_en": ["I'm learning Chinese.", "Chinese."]
        },
        {
          "partner_zh": "你说得很好！",
          "partner_en": "You speak it really well!",
          "prompt_en": "Say thanks, you're still learning.",
          "answers_zh": ["谢谢，我还在学。", "哪里哪里。"],
          "answers_en": ["Thanks, I'm still learning.", "Oh, not really."]
        },
        {
          "partner_zh": "下次一起吃饭吧！",
          "partner_en": "Let's have dinner together next time!",
          "prompt_en": "Say great, see you next time.",
          "answers_zh": ["太好了，下次见！", "好啊！"],
          "answers_en": ["Great, see you next time!", "Sure!"]
        }
      ],
      "closing_zh": "好，下次见！",
      "closing_en": "OK, see you next time!"
    },
    {
