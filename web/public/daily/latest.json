  "missions": [
    {
      "id": "2026-11-22-m1",
      "level": 2,
      "title": "A late taxi home",
      "role": "司机",
      "goal": "Take a taxi home late at night: say where you're going and where to stop.",
      "new_words": [
        {
          "word": "安全",
          "english": "safe"
        },
        {
          "word": "或者",
          "english": "or"
        },
        {
          "word": "发",
          "english": "to send"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，去哪儿？",
          "partner_en": "Hi, where to?",
          "prompt_en": "Say you're going to the university.",
          "answers_zh": [
            "我去大学。",
            "去大学，谢谢。"
          ],
          "answers_en": [
            "To the university.",
            "The university, please."
          ]
        },
        {
          "partner_zh": "大学很大。你在哪个门下车？",
          "partner_en": "The university's big. Which gate do you want?",
          "prompt_en": "Say you'll send them the location on your phone.",
          "answers_zh": [
            "我给你发一下。",
            "我用手机发给你。"
          ],
          "answers_en": [
            "I'll send it to you.",
            "I'll send it from my phone."
          ]
        },
        {
          "partner_zh": "好。在门口停，或者开进去？",
          "partner_en": "OK. Stop at the gate, or drive in?",
          "prompt_en": "Say stop at the gate is fine.",
          "answers_zh": [
            "在门口停就可以。",
            "门口就行。"
          ],
          "answers_en": [
            "Stopping at the gate is fine.",
            "The gate's fine."
          ]
        },
        {
          "partner_zh": "这么晚了，你一个人安全吗？",
          "partner_en": "It's so late — will you be safe on your own?",
          "prompt_en": "Say yes, it's safe, your room is very close.",
          "answers_zh": [
            "安全，我的房间就在前边。",
            "没问题，很安全。"
          ],
          "answers_en": [
            "Yes, my room's just ahead.",
            "No problem, it's very safe."
          ]
        }
      ],
      "closing_zh": "好，到了。慢点走！",
      "closing_en": "Right, here we are. Take care!"
    },
    {
      "id": "2026-11-22-m2",
      "level": 2,
      "title": "Exam results",
      "role": "朋友",
      "goal": "Your friend asks how your exam went. Tell them the result.",
      "new_words": [
        {
          "word": "结果",
          "english": "result"
        },
        {
          "word": "完全",
          "english": "completely"
        },
        {
          "word": "不错",
          "english": "pretty good"
        }
      ],
      "steps": [
        {
          "partner_zh": "考试的结果出来了吗？",
          "partner_en": "Are your exam results out?",
          "prompt_en": "Say yes, they came out today.",
          "answers_zh": [
            "出来了，今天出来的。",
            "出来了！"
          ],
          "answers_en": [
            "Yes, they came out today.",
            "Yes!"
          ]
        },
        {
          "partner_zh": "怎么样？",
          "partner_en": "How did it go?",
          "prompt_en": "Say pretty good — you passed.",
          "answers_zh": [
            "不错，我通过了！",
            "很不错，我过了。"
          ],
          "answers_en": [
            "Pretty good — I passed!",
            "Really good, I passed."
          ]
        },
        {
          "partner_zh": "太好了！难不难？",
          "partner_en": "Brilliant! Was it hard?",
          "prompt_en": "Say very hard; one part you didn't understand at all.",
          "answers_zh": [
            "很难，有一个地方我完全不会。",
            "很难，有的我完全不知道。"
          ],
          "answers_en": [
            "Really hard — there was one part I couldn't do at all.",
            "Really hard; some of it I had no idea about."
          ]
        },
        {
          "partner_zh": "可是你还是通过了！我们去吃饭吧。",
          "partner_en": "But you still passed! Let's go out to eat.",
          "prompt_en": "Say great, you're paying!",
          "answers_zh": [
            "好啊，你请客！",
            "好，今天你请！"
          ],
          "answers_en": [
            "Great — your treat!",
            "OK, you're buying today!"
          ]
        }
      ],
      "closing_zh": "哈哈，好，我请！",
      "closing_en": "Haha, fine, my treat!"
    }
  ]
}
