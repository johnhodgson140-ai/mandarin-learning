    {
      "id": "2026-10-19-s1",
      "level": 1,
      "topic": "archive fashion",
      "title_zh": "我爱老衣服",
      "title_en": "I love old clothes",
      "paragraphs": [
        ["我", "很", "喜欢", "穿", "老", "衣服", "。", "新", "的", "都", "一样", "，", "老", "的", "都", "不", "一样", "。"],
        ["上", "个", "月", "，", "我", "在", "闲鱼", "上", "买", "了", "一些", "二十", "年", "前", "的", "衣服", "。"],
        ["有的", "很", "大", "，", "有的", "很", "小", "。", "我", "试", "了", "试", "，", "都", "很", "好", "。"],
        ["我", "花", "了", "两百", "块", "，", "不", "多", "！"],
        ["我", "哥", "看见", "了", "，", "说", "：", "“", "这些", "衣服", "真", "好", "！", "我", "也", "想", "要", "。", "”"]
      ],
      "translations": [
        "I love wearing old clothes. New ones are all the same, but old ones are all different.",
        "Last month I bought some twenty-year-old clothes on Xianyu.",
        "Some are big and some are small. I tried them on, and they're all great.",
        "I spent 200 kuai — not much!",
        "My brother saw them and said: “These clothes are great! I want some too.”"
      ],
      "names": ["闲鱼"],
      "new_words": ["衣服"],
      "glossary": [
        { "word": "衣服", "english": "clothes" },
        { "word": "闲鱼", "english": "Xianyu (second-hand marketplace app)" }
      ]
    },
    {
      "id": "2026-10-19-s2",
      "level": 1,
      "topic": "daily life",
      "title_zh": "妈妈的生日",
      "title_en": "Mum's birthday",
      "paragraphs": [
        ["今天", "是", "妈妈", "的", "生日", "。", "我", "和", "爸爸", "一起", "做", "了", "很", "多", "菜", "。", "爸爸", "做", "肉", "，", "我", "做", "别的", "。"],
        ["我们", "做", "了", "两", "个", "小时", "，", "都", "很", "饿", "了", "。"],
        ["晚上", "六", "点", "，", "妈妈", "回家", "了", "。", "她", "看到", "了", "很", "多", "菜", "，", "非常", "高兴", "。"],
        ["我们", "一边", "吃", "，", "一边", "笑", "。", "我", "还", "送", "了", "妈妈", "一", "个", "白", "包", "。"],
        ["妈妈", "说", "：", "“", "这", "是", "我", "最", "好", "的", "生日", "！", "”"]
      ],
      "translations": [
        "Today is Mum's birthday. Dad and I made lots of dishes together. Dad did the meat, and I did the rest.",
        "We cooked for two hours and were both really hungry.",
        "At six in the evening Mum came home. She saw all the dishes and was really happy.",
        "We laughed as we ate. I also gave Mum a white bag.",
        "Mum said: “This is my best birthday ever!”"
      ],
      "names": [],
      "new_words": ["生日", "菜", "饿"],
      "glossary": [
        { "word": "生日", "english": "birthday" },
        { "word": "菜", "english": "dish (of food)" },
        { "word": "饿", "english": "hungry" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-19-m1",
      "level": 1,
      "title": "Finding the east exit",
      "role": "路人",
      "goal": "Ask a passer-by how to get to the station's east exit, check the turns and thank them.",
      "new_words": [
        { "word": "右", "english": "right" },
        { "word": "东", "english": "east" },
        { "word": "树", "english": "tree" }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么事吗？",
          "partner_en": "Hi, can I help?",
          "prompt_en": "Ask how to get to the east exit.",
          "answers_zh": ["请问，东口怎么走？", "东出口在哪儿？"],
          "answers_en": ["Excuse me, how do I get to the east exit?", "Where's the east exit?"]
        },
        {
          "partner_zh": "往前走，到了大树那里往右。",
          "partner_en": "Go straight on, and turn right at the big tree.",
          "prompt_en": "Check: turn right at the big tree?",
          "answers_zh": ["在大树那里往右，对吗？", "到树那儿往右？"],
          "answers_en": ["Turn right at the big tree, right?", "Right at the tree?"]
        },
        {
          "partner_zh": "对。然后再往左走一点。",
          "partner_en": "Yes. Then go left a little.",
          "prompt_en": "Ask if it's far.",
          "answers_zh": ["远不远？", "远吗？"],
          "answers_en": ["Is it far?", "Far?"]
        },
        {
          "partner_zh": "不远，走五分钟就到了。",
          "partner_en": "Not far — five minutes' walk.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["太好了，谢谢！", "谢谢你！"],
          "answers_en": ["Great, thanks!", "Thank you!"]
        }
      ],
      "closing_zh": "不客气。",
      "closing_en": "You're welcome."
    },
    {
      "id": "2026-10-19-m2",
      "level": 1,
      "title": "Starving at a restaurant",
      "role": "服务员",
      "goal": "Say you're hungry, ask which dishes are good, order and ask for it to be quick.",
      "new_words": [
        { "word": "菜", "english": "dish (of food)" },
        { "word": "饿", "english": "hungry" }
      ],
      "steps": [
        {
          "partner_zh": "你好，几位？",
          "partner_en": "Hello, how many?",
          "prompt_en": "Say just one, and you're really hungry.",
          "answers_zh": ["一个人，我很饿！", "就我一个，我饿了。"],
          "answers_en": ["One — and I'm really hungry!", "Just me, I'm starving."]
        },
        {
          "partner_zh": "好的，这是菜单。",
          "partner_en": "OK, here's the menu.",
          "prompt_en": "Ask which dishes are good.",
          "answers_zh": ["什么菜好吃？", "你们什么菜最好？"],
          "answers_en": ["Which dishes are good?", "What's your best dish?"]
        },
        {
          "partner_zh": "这个鱼和这个鸡都很好。",
          "partner_en": "This fish and this chicken are both very good.",
          "prompt_en": "Order the fish and a bowl of rice.",
          "answers_zh": ["我要这个鱼，还有一碗米饭。", "来一个鱼，一碗米饭。"],
          "answers_en": ["I'll have the fish and a bowl of rice.", "One fish and a bowl of rice."]
        },
        {
          "partner_zh": "要快一点吗？",
          "partner_en": "Would you like it quickly?",
          "prompt_en": "Say yes, please be quick.",
          "answers_zh": ["对，请快一点。", "是的，越快越好。"],
          "answers_en": ["Yes, please be quick.", "Yes — the sooner the better."]
        },
        {
          "partner_zh": "好的，马上上菜。",
          "partner_en": "OK, the food will be right out.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢！", "好的，谢谢你！"],
          "answers_en": ["Thanks!", "OK, thank you!"]
        }
      ],
      "closing_zh": "不客气，请慢用！",
      "closing_en": "You're welcome, enjoy your meal!"
    }
  ]
}
