    {
      "id": "2026-10-13-s1",
      "level": 1,
      "topic": "football",
      "title_zh": "买到票了",
      "title_en": "I got a ticket",
      "paragraphs": [
        ["下", "个", "月", "有", "曼联", "的", "球", "。", "曼联", "是", "我", "最", "爱", "的", "。", "我", "很", "想", "去", "看", "！"],
        ["我", "在", "手机", "上", "找", "票", "。", "票", "不", "多", "了", "。"],
        ["第二", "天", "，", "我", "还是", "没有", "买", "到", "。", "我", "问", "了", "很", "多", "人", "，", "他们", "都", "没有", "。"],
        ["最后", "，", "朋友", "帮", "我", "买", "到", "了", "票", "！"],
        ["我", "非常", "高兴", "！", "我", "说", "：", "“", "谢谢", "你", "！", "我们", "一起", "去", "看", "球", "吧", "！", "”"]
      ],
      "translations": [
        "Man United are playing next month. They’re my favourite team. I really want to go and watch!",
        "I looked for tickets on my phone. There weren’t many left.",
        "The next day I still hadn’t managed to buy one. I asked lots of people, but none of them had any.",
        "In the end my friend helped me get a ticket!",
        "I was so happy! I said: “Thank you! Let’s go and watch the match together!”"
      ],
      "names": ["曼联"],
      "new_words": ["票", "高兴"],
      "glossary": [
        { "word": "票", "english": "ticket" },
        { "word": "高兴", "english": "happy" },
        { "word": "曼联", "english": "Manchester United" }
      ]
    },
    {
      "id": "2026-10-13-s2",
      "level": 1,
      "topic": "daily life",
      "title_zh": "不想睡",
      "title_en": "Not sleepy",
      "paragraphs": [
        ["晚上", "十", "点", "，", "我", "想", "睡觉", "。", "我", "在", "床", "上", "看", "手机", "，", "看", "了", "一", "个", "小时", "。"],
        ["十二", "点", "了", "，", "我", "还是", "不", "想", "睡", "。", "我", "就", "起来", "用", "电脑", "工作", "。", "工作", "很", "多", "，", "我", "做", "了", "两", "个", "小时", "。"],
        ["两", "点", "，", "我", "睡", "了", "。"],
        ["第二", "天", "，", "我", "十", "点", "起来", "，", "起来", "晚", "了", "！"],
        ["今天", "晚上", "，", "我", "不", "看", "手机", "了", "！", "我", "要", "十", "点", "就", "睡", "！"]
      ],
      "translations": [
        "At ten in the evening I wanted to go to bed. I looked at my phone in bed for an hour.",
        "At midnight I still didn’t want to sleep. So I got up and worked on my computer. There was lots of work — I did two hours.",
        "At two I fell asleep.",
        "The next day I got up at ten — I overslept!",
        "Tonight, no more phone! I’m going to sleep at ten!"
      ],
      "names": [],
      "new_words": ["睡觉", "床", "电脑"],
      "glossary": [
        { "word": "睡觉", "english": "to go to bed; to sleep" },
        { "word": "床", "english": "bed" },
        { "word": "电脑", "english": "computer" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-13-m1",
      "level": 1,
      "title": "Buying a train ticket",
      "role": "售票员",
      "goal": "Buy a ticket to Shanghai: choose a train, check the station and seat class, and ask the price.",
      "new_words": [
        { "word": "票", "english": "ticket" },
        { "word": "西", "english": "west" },
        { "word": "第", "english": "(ordinal prefix: 第五 = fifth)" }
      ],
      "steps": [
        {
          "partner_zh": "你好，去哪儿？",
          "partner_en": "Hello, where to?",
          "prompt_en": "Say you want a ticket to Shanghai.",
          "answers_zh": ["我要一张去上海的票。", "去上海，一张票。"],
          "answers_en": ["I'd like a ticket to Shanghai.", "Shanghai, one ticket."]
        },
        {
          "partner_zh": "几点的？",
          "partner_en": "What time?",
          "prompt_en": "Ask when the next one is.",
          "answers_zh": ["下一班几点？", "最早的是几点？"],
          "answers_en": ["When's the next one?", "What time is the earliest?"]
        },
        {
          "partner_zh": "十点半的，从西站走。",
          "partner_en": "Half past ten, leaving from the West station.",
          "prompt_en": "Check: is it the West station?",
          "answers_zh": ["是西站吗？", "在西站坐车吗？"],
          "answers_en": ["The West station?", "So I get on at the West station?"]
        },
        {
          "partner_zh": "对，西站。要一等座还是二等座？",
          "partner_en": "Yes, West station. First class or second class?",
          "prompt_en": "Say second class.",
          "answers_zh": ["二等座。", "二等座就行。"],
          "answers_en": ["Second class.", "Second class is fine."]
        },
        {
          "partner_zh": "好的，第五车厢。",
          "partner_en": "OK, carriage five.",
          "prompt_en": "Ask how much it is.",
          "answers_zh": ["一共多少钱？", "多少钱？"],
          "answers_en": ["How much is that altogether?", "How much?"]
        }
      ],
      "closing_zh": "五百五十三块。",
      "closing_en": "553 kuai."
    },
    {
      "id": "2026-10-13-m2",
      "level": 1,
      "title": "At a computer repair shop",
      "role": "店员",
      "goal": "Explain your computer won't start, ask for it to be fixed quickly and ask the price.",
      "new_words": [
        { "word": "电脑", "english": "computer" },
        { "word": "试", "english": "to try" }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么问题？",
          "partner_en": "Hello, what's the problem?",
          "prompt_en": "Say your computer won't turn on.",
          "answers_zh": ["我的电脑开不了机。", "电脑打不开了。"],
          "answers_en": ["My computer won't turn on.", "My computer won't start."]
        },
        {
          "partner_zh": "什么时候开始的？",
          "partner_en": "When did it start?",
          "prompt_en": "Say since yesterday.",
          "answers_zh": ["昨天开始的。", "从昨天开始。"],
          "answers_en": ["It started yesterday.", "Since yesterday."]
        },
        {
          "partner_zh": "我先看看。你明天能来拿吗？",
          "partner_en": "I'll take a look first. Can you pick it up tomorrow?",
          "prompt_en": "Ask if it can be quicker — you need it for work.",
          "answers_zh": ["能快一点吗？我要工作。", "今天能好吗？"],
          "answers_en": ["Could it be quicker? I need it for work.", "Could it be ready today?"]
        },
        {
          "partner_zh": "那下午五点吧。",
          "partner_en": "Five this afternoon, then.",
          "prompt_en": "Ask how much it will cost.",
          "answers_zh": ["要多少钱？", "多少钱？"],
          "answers_en": ["How much will it cost?", "How much?"]
        },
        {
          "partner_zh": "我先试试，可能两百块。",
          "partner_en": "I'll try first — maybe 200 kuai.",
          "prompt_en": "Say OK, see you at five.",
          "answers_zh": ["好的，五点见。", "行，下午五点来。"],
          "answers_en": ["OK, see you at five.", "Fine, I'll come at five this afternoon."]
        }
      ],
      "closing_zh": "好，到时候见！",
      "closing_en": "Great, see you then!"
    }
  ]
}
