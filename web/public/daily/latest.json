  "missions": [
    {
      "id": "2026-11-28-m1",
      "level": 2,
      "title": "Buying a present",
      "role": "卖东西的",
      "goal": "Buy some tea as a present at a shop. Ask what's good and the price.",
      "new_words": [
        {
          "word": "卖",
          "english": "to sell"
        },
        {
          "word": "选",
          "english": "to choose"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！想买什么？",
          "partner_en": "Hello! What are you after?",
          "prompt_en": "Ask if they sell tea.",
          "answers_zh": [
            "你们卖茶吗？",
            "这里卖不卖茶？"
          ],
          "answers_en": [
            "Do you sell tea?",
            "Do you sell tea here?"
          ]
        },
        {
          "partner_zh": "卖！我们有很多茶，你自己选吧。",
          "partner_en": "We do! We've got lots — take your pick.",
          "prompt_en": "Say it's a present for your mum — ask which is good.",
          "answers_zh": [
            "我想送给妈妈，哪种好？",
            "是送给我妈妈的，你帮我选吧。"
          ],
          "answers_en": [
            "It's for my mum — which one's good?",
            "It's a present for my mum — can you help me choose?"
          ]
        },
        {
          "partner_zh": "这种茶很有名，大家都喜欢。",
          "partner_en": "This tea is famous — everyone likes it.",
          "prompt_en": "Ask how much it is.",
          "answers_zh": [
            "多少钱？",
            "这个多少钱？"
          ],
          "answers_en": [
            "How much?",
            "How much is this one?"
          ]
        },
        {
          "partner_zh": "一百块。",
          "partner_en": "A hundred kuai.",
          "prompt_en": "Say OK, you'll take it.",
          "answers_zh": [
            "好，我要了。",
            "可以，就选这个。"
          ],
          "answers_en": [
            "OK, I'll take it.",
            "Fine, I'll go with this one."
          ]
        }
      ],
      "closing_zh": "好的，谢谢！你妈妈一定会喜欢。",
      "closing_en": "Great, thanks! Your mum will definitely love it."
    },
    {
      "id": "2026-11-28-m2",
      "level": 2,
      "title": "What does this line mean?",
      "role": "老师",
      "goal": "Ask your teacher to explain a line in the text you don't understand.",
      "new_words": [
        {
          "word": "句",
          "english": "(measure word for sentences)"
        },
        {
          "word": "讲",
          "english": "to explain"
        },
        {
          "word": "方法",
          "english": "method; way"
        }
      ],
      "steps": [
        {
          "partner_zh": "有问题吗？",
          "partner_en": "Any questions?",
          "prompt_en": "Say there's one line you don't understand.",
          "answers_zh": [
            "老师，这句话我不明白。",
            "有一句我不明白。"
          ],
          "answers_en": [
            "Teacher, I don't understand this line.",
            "There's one line I don't get."
          ]
        },
        {
          "partner_zh": "哪一句？",
          "partner_en": "Which line?",
          "prompt_en": "Say the last line of the text.",
          "answers_zh": [
            "课文最后一句。",
            "最后那句。"
          ],
          "answers_en": [
            "The last line of the text.",
            "The last one."
          ]
        },
        {
          "partner_zh": "好，我给你讲一下。……现在明白了吗？",
          "partner_en": "OK, let me explain. … Do you get it now?",
          "prompt_en": "Say yes, and ask what the best way to learn characters is.",
          "answers_zh": [
            "明白了！学汉字有什么好方法？",
            "明白了。学汉字，什么方法好？"
          ],
          "answers_en": [
            "Got it! Is there a good way to learn characters?",
            "Yes. What's a good way to learn characters?"
          ]
        },
        {
          "partner_zh": "多读，多写。这是最好的方法。",
          "partner_en": "Read a lot and write a lot. That's the best way.",
          "prompt_en": "Thank them.",
          "answers_zh": [
            "谢谢老师！",
            "好的，谢谢您。"
          ],
          "answers_en": [
            "Thank you!",
            "OK, thank you."
          ]
        }
      ],
      "closing_zh": "不客气，明天见。",
      "closing_en": "You're welcome. See you tomorrow."
    }
