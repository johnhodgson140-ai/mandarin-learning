  "missions": [
    {
      "id": "2026-11-02-m1",
      "level": 1,
      "title": "Booking a table",
      "role": "服务员",
      "goal": "Phone a restaurant to book a table for four on Saturday evening and confirm the date.",
      "new_words": [
        { "word": "饭店", "english": "restaurant" },
        { "word": "日期", "english": "date" }
      ],
      "steps": [
        {
          "partner_zh": "你好，这里是小王饭店。",
          "partner_en": "Hello, Xiao Wang's Restaurant.",
          "prompt_en": "Say you'd like to book a table.",
          "answers_zh": ["你好，我想订一个桌子。", "我想订位。"],
          "answers_en": ["Hello, I'd like to book a table.", "I'd like to make a booking."]
        },
        {
          "partner_zh": "好的，哪天？",
          "partner_en": "Sure, which day?",
          "prompt_en": "Say this Saturday evening.",
          "answers_zh": ["这个星期六晚上。", "星期六晚上。"],
          "answers_en": ["This Saturday evening.", "Saturday evening."]
        },
        {
          "partner_zh": "几位？",
          "partner_en": "How many people?",
          "prompt_en": "Say four.",
          "answers_zh": ["四个人。", "四位。"],
          "answers_en": ["Four people.", "Four."]
        },
        {
          "partner_zh": "星期六是几号？我看一下日期。",
          "partner_en": "What date is Saturday? Let me check the date.",
          "prompt_en": "Say the 7th.",
          "answers_zh": ["七号。", "是七号。"],
          "answers_en": ["The 7th.", "It's the 7th."]
        },
        {
          "partner_zh": "好的，七号晚上，四位。",
          "partner_en": "OK, the evening of the 7th, four people.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["太好了，谢谢！", "好的，谢谢！"],
          "answers_en": ["Great, thanks!", "OK, thank you!"]
        }
      ],
      "closing_zh": "不客气，到时候见！",
      "closing_en": "You're welcome, see you then!"
    },
    {
      "id": "2026-11-02-m2",
      "level": 1,
      "title": "Chatting about school",
      "role": "同事",
      "goal": "Talk with a colleague about your sister's school and their son starting primary school.",
      "new_words": [
        { "word": "小学", "english": "primary school" },
        { "word": "中学", "english": "secondary school" }
      ],
      "steps": [
        {
          "partner_zh": "你妹妹上小学还是中学？",
          "partner_en": "Is your sister at primary school or secondary school?",
          "prompt_en": "Say secondary school.",
          "answers_zh": ["她上中学。", "中学。"],
          "answers_en": ["She's at secondary school.", "Secondary."]
        },
        {
          "partner_zh": "她几年级？",
          "partner_en": "Which year is she in?",
          "prompt_en": "Say second year.",
          "answers_zh": ["她上二年级。", "二年级。"],
          "answers_en": ["She's in year two.", "Year two."]
        },
        {
          "partner_zh": "她喜欢学校吗？",
          "partner_en": "Does she like school?",
          "prompt_en": "Say yes, she really likes her teacher.",
          "answers_zh": ["喜欢，她很喜欢她的老师。", "很喜欢。"],
          "answers_en": ["Yes, she really likes her teacher.", "She loves it."]
        },
        {
          "partner_zh": "我儿子明年上小学。",
          "partner_en": "My son starts primary school next year.",
          "prompt_en": "Ask how old he is.",
          "answers_zh": ["他今年几岁？", "他几岁了？"],
          "answers_en": ["How old is he this year?", "How old is he?"]
        },
        {
          "partner_zh": "六岁了。",
          "partner_en": "He's six.",
          "prompt_en": "Say time flies.",
          "answers_zh": ["真快啊！", "时间过得真快！"],
          "answers_en": ["That went fast!", "Time flies!"]
        }
      ],
      "closing_zh": "是啊，真快！",
      "closing_en": "Yes, so fast!"
    }
  ]
