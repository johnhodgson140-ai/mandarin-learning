      "title": "At the laundry",
      "role": "店员",
      "goal": "Drop off a jacket for washing, ask when it's ready and the price, and point out a damaged spot.",
      "new_words": [
        { "word": "洗", "english": "to wash" },
        { "word": "坏", "english": "broken; damaged" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要洗什么？",
          "partner_en": "Hello, what would you like washed?",
          "prompt_en": "Say you'd like this jacket washed.",
          "answers_zh": ["我想洗这件外套。", "这件外套要洗。"],
          "answers_en": ["I'd like to have this jacket washed.", "This jacket needs washing."]
        },
        {
          "partner_zh": "好的。什么时候要？",
          "partner_en": "OK. When do you need it?",
          "prompt_en": "Ask if tomorrow is OK.",
          "answers_zh": ["明天可以吗？", "明天能好吗？"],
          "answers_en": ["Is tomorrow OK?", "Could it be ready tomorrow?"]
        },
        {
          "partner_zh": "明天下午可以。",
          "partner_en": "Tomorrow afternoon is fine.",
          "prompt_en": "Ask how much it is.",
          "answers_zh": ["洗一件多少钱？", "多少钱？"],
          "answers_en": ["How much is it per item?", "How much?"]
        },
        {
          "partner_zh": "三十块。",
          "partner_en": "30 kuai.",
          "prompt_en": "Say this part is a bit damaged — please be careful.",
          "answers_zh": ["这里有点坏了，请小心。", "这儿坏了一点。"],
          "answers_en": ["It's a bit damaged here — please be careful.", "This bit's slightly damaged."]
        },
        {
          "partner_zh": "没问题，我们会注意的。",
          "partner_en": "No problem, we'll be careful.",
          "prompt_en": "Say thanks, you'll come and collect it tomorrow afternoon.",
          "answers_zh": ["好的，明天下午来拿。", "谢谢，明天下午见。"],
          "answers_en": ["OK, I'll pick it up tomorrow afternoon.", "Thanks, see you tomorrow afternoon."]
        }
      ],
      "closing_zh": "好的，这是你的单子。",
      "closing_en": "OK, here's your ticket."
    },
