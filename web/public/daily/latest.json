    {
      "id": "2026-10-14-m1",
      "level": 1,
      "title": "A language exchange",
      "role": "朋友",
      "goal": "Agree to swap lessons: they teach you Chinese, you teach them English.",
      "new_words": [
        { "word": "教", "english": "to teach" },
        { "word": "认真", "english": "serious; hard-working" },
        { "word": "字", "english": "character (written)" }
      ],
      "steps": [
        {
          "partner_zh": "你好！你在学中文吗？",
          "partner_en": "Hi! Are you learning Chinese?",
          "prompt_en": "Say yes, you're learning Chinese.",
          "answers_zh": ["是的，我在学中文。", "对，我正在学中文。"],
          "answers_en": ["Yes, I'm learning Chinese.", "That's right, I'm learning Chinese."]
        },
        {
          "partner_zh": "难不难？",
          "partner_en": "Is it hard?",
          "prompt_en": "Say writing characters is hard.",
          "answers_zh": ["写字很难。", "汉字很难。"],
          "answers_en": ["Writing characters is hard.", "Chinese characters are hard."]
        },
        {
          "partner_zh": "我可以教你！",
          "partner_en": "I can teach you!",
          "prompt_en": "Say great, and you can teach them English.",
          "answers_zh": ["太好了！我可以教你英语。", "好啊，我教你英语吧。"],
          "answers_en": ["Great! I can teach you English.", "Sure, I'll teach you English."]
        },
        {
          "partner_zh": "好啊！我们什么时候开始？",
          "partner_en": "Sounds good! When shall we start?",
          "prompt_en": "Suggest tomorrow afternoon.",
          "answers_zh": ["明天下午吧。", "明天下午怎么样？"],
          "answers_en": ["Tomorrow afternoon.", "How about tomorrow afternoon?"]
        },
        {
          "partner_zh": "你要认真学哦！",
          "partner_en": "You have to study hard, OK?",
          "prompt_en": "Say you'll study hard.",
          "answers_zh": ["我会认真学的。", "没问题，我会认真的。"],
          "answers_en": ["I'll study hard.", "No problem, I'll take it seriously."]
        }
      ],
      "closing_zh": "好，明天见！",
      "closing_en": "Great, see you tomorrow!"
    },
    {
      "id": "2026-10-14-m2",
      "level": 1,
      "title": "A power cut at home",
      "role": "房东",
      "goal": "Tell your landlord the power is out, explain when it started and ask how long the fix will take.",
      "new_words": [
        { "word": "电", "english": "electricity" },
        { "word": "家里", "english": "at home" },
        { "word": "回到", "english": "to get back to" }
      ],
      "steps": [
        {
          "partner_zh": "喂，你好。",
          "partner_en": "Hello?",
          "prompt_en": "Say there's no electricity at home.",
          "answers_zh": ["你好，我家里没电了。", "喂，家里没有电了。"],
          "answers_en": ["Hi, there's no power at my place.", "Hello, the electricity's gone at home."]
        },
        {
          "partner_zh": "什么时候开始的？",
          "partner_en": "When did it start?",
          "prompt_en": "Say when you got home at seven there was no power.",
          "answers_zh": ["我七点回到家就没电了。", "七点开始的。"],
          "answers_en": ["When I got home at seven there was no power.", "Since seven."]
        },
        {
          "partner_zh": "别的房间也没电吗？",
          "partner_en": "Is there no power in the other rooms either?",
          "prompt_en": "Say none of the rooms have power.",
          "answers_zh": ["都没有电。", "每个房间都没电。"],
          "answers_en": ["None of them have power.", "There's no power in any room."]
        },
        {
          "partner_zh": "好，我马上找人来看。",
          "partner_en": "OK, I'll get someone to look at it right away.",
          "prompt_en": "Ask how long it will take.",
          "answers_zh": ["要多长时间？", "什么时候能好？"],
          "answers_en": ["How long will it take?", "When will it be fixed?"]
        },
        {
          "partner_zh": "一个小时吧。",
          "partner_en": "About an hour.",
          "prompt_en": "Say OK, thanks.",
          "answers_zh": ["好的，谢谢！", "行，我等你们。"],
          "answers_en": ["OK, thanks!", "Fine, I'll wait for you."]
        }
      ],
      "closing_zh": "不客气，不好意思！",
      "closing_en": "You're welcome — sorry about that!"
    }
  ]
