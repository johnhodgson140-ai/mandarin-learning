  "missions": [
    {
      "id": "2026-10-07-m1",
      "level": 1,
      "title": "At a bubble tea shop",
      "role": "店员",
      "goal": "Order two milk teas, choose sugar and temperature, and agree to wait.",
      "new_words": [
        { "word": "杯", "english": "cup (measure word for drinks)" },
        { "word": "明白", "english": "to understand" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要喝点什么？",
          "partner_en": "Hi, what would you like to drink?",
          "prompt_en": "Ask for a cup of milk tea.",
          "answers_zh": ["我要一杯奶茶。", "一杯奶茶，谢谢。"],
          "answers_en": ["I'd like a milk tea.", "A milk tea, please."]
        },
        {
          "partner_zh": "要几分甜？",
          "partner_en": "How sweet would you like it?",
          "prompt_en": "Say half sugar.",
          "answers_zh": ["半糖。", "要半糖的。"],
          "answers_en": ["Half sugar.", "Half sugar, please."]
        },
        {
          "partner_zh": "要冰的还是热的？",
          "partner_en": "Iced or hot?",
          "prompt_en": "Say hot.",
          "answers_zh": ["热的。", "我要热的。"],
          "answers_en": ["Hot.", "Hot, please."]
        },
        {
          "partner_zh": "好的，还要别的吗？",
          "partner_en": "OK, anything else?",
          "prompt_en": "Say one more cup, the same.",
          "answers_zh": ["再来一杯一样的。", "再要一杯，一样的。"],
          "answers_en": ["One more, the same.", "Another cup, the same, please."]
        },
        {
          "partner_zh": "两杯一共三十块。要等十分钟，可以吗？",
          "partner_en": "Two cups, 30 kuai altogether. It'll be a ten-minute wait — is that OK?",
          "prompt_en": "Say you understand, no problem.",
          "answers_zh": ["明白，没问题。", "好的，我等一下。"],
          "answers_en": ["Got it, no problem.", "OK, I'll wait."]
        }
      ],
      "closing_zh": "好了，这是你的两杯奶茶！",
      "closing_en": "Here you go, your two milk teas!"
    },
    {
      "id": "2026-10-07-m2",
      "level": 1,
      "title": "Talking about family",
      "role": "同事",
