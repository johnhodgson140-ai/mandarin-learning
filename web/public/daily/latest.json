  "missions": [
    {
      "id": "2026-11-10-m1",
      "level": 1,
      "title": "Sharing a taxi",
      "role": "朋友",
      "goal": "It's raining: agree to share a taxi with a friend, say where you live and where you'll sit.",
      "new_words": [
        { "word": "打车", "english": "to take a taxi" },
        { "word": "西边", "english": "the west side" },
        { "word": "后边", "english": "the back" }
      ],
      "steps": [
        {
          "partner_zh": "下雨了，我们打车吧？",
          "partner_en": "It's raining — shall we get a taxi?",
          "prompt_en": "Say good idea.",
          "answers_zh": ["好啊，打车吧。", "好主意。"],
          "answers_en": ["Sure, let's get a taxi.", "Good idea."]
        },
        {
          "partner_zh": "你家在哪儿？",
          "partner_en": "Where do you live?",
          "prompt_en": "Say on the west side, next to the train station.",
          "answers_zh": ["我家在西边，火车站旁边。", "在西边。"],
          "answers_en": ["On the west side, next to the train station.", "On the west side."]
        },
        {
          "partner_zh": "我家在东边。我们先去你家吧。",
          "partner_en": "I'm on the east side. Let's go to yours first.",
          "prompt_en": "Say OK, thanks.",
          "answers_zh": ["好的，谢谢！", "太好了。"],
          "answers_en": ["OK, thanks!", "Great."]
        },
        {
          "partner_zh": "车来了！你坐前边还是后边？",
          "partner_en": "Here's the taxi! Do you want the front or the back?",
          "prompt_en": "Say the back.",
          "answers_zh": ["我坐后边。", "后边吧。"],
          "answers_en": ["I'll sit in the back.", "The back."]
        }
      ],
      "closing_zh": "好，走吧！",
      "closing_en": "OK, let's go!"
    },
    {
      "id": "2026-11-10-m2",
      "level": 1,
      "title": "Buying a textbook",
      "role": "店员",
      "goal": "Buy a Chinese textbook and two notebooks at a bookshop, and pay.",
      "new_words": [
        { "word": "课本", "english": "textbook" },
        { "word": "本子", "english": "notebook" },
        { "word": "上边", "english": "on top; above" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要什么？",
          "partner_en": "Hi, what can I help you find?",
          "prompt_en": "Say you need a Chinese textbook.",
          "answers_zh": ["我要一本汉语课本。", "有汉语课本吗？"],
          "answers_en": ["I need a Chinese textbook.", "Do you have Chinese textbooks?"]
        },
        {
          "partner_zh": "在那边，书架上边。",
          "partner_en": "Over there, on the top of the bookshelf.",
          "prompt_en": "Ask if they have notebooks too.",
          "answers_zh": ["还有本子吗？", "我还要两个本子。"],
          "answers_en": ["Do you have notebooks too?", "I'd also like two notebooks."]
        },
        {
          "partner_zh": "本子在这儿，三块一个。",
          "partner_en": "Notebooks are here — three kuai each.",
          "prompt_en": "Say you'll take two.",
          "answers_zh": ["我要两个。", "给我两个。"],
          "answers_en": ["I'll take two.", "Two, please."]
        },
        {
          "partner_zh": "一共四十六块。",
          "partner_en": "Forty-six kuai altogether.",
          "prompt_en": "Say you'll pay by phone.",
          "answers_zh": ["我用手机给。", "可以用手机吗？"],
          "answers_en": ["I'll pay by phone.", "Can I pay by phone?"]
        }
      ],
      "closing_zh": "可以，谢谢！",
      "closing_en": "Sure, thank you!"
    }
  ]
