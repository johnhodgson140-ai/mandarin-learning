  "missions": [
    {
      "id": "2026-11-25-m1",
      "level": 2,
      "title": "Asking the way",
      "role": "路人",
      "goal": "You're lost on the way to the library. Ask a passer-by for help.",
      "new_words": [
        {
          "word": "帮助",
          "english": "help"
        },
        {
          "word": "能够",
          "english": "to be able to"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，需要帮助吗？",
          "partner_en": "Hi, do you need any help?",
          "prompt_en": "Say yes — you're looking for the library.",
          "answers_zh": [
            "要，我在找图书馆。",
            "对，请问图书馆在哪儿？"
          ],
          "answers_en": [
            "Yes, I'm looking for the library.",
            "Yes — where's the library?"
          ]
        },
        {
          "partner_zh": "图书馆在学校里边。你知道学校在哪儿吗？",
          "partner_en": "The library's inside the school. Do you know where the school is?",
          "prompt_en": "Say no, you don't know.",
          "answers_zh": [
            "不知道。",
            "我不知道。"
          ],
          "answers_en": [
            "No idea.",
            "I don't know."
          ]
        },
        {
          "partner_zh": "你一直走，到第一个路口向右走，就到了。",
          "partner_en": "Go straight, turn right at the first junction, and you're there.",
          "prompt_en": "Repeat the directions back.",
          "answers_zh": [
            "一直走，第一个路口向右，对吗？",
            "好，第一个路口向右。"
          ],
          "answers_en": [
            "Straight on, right at the first junction — right?",
            "OK, right at the first junction."
          ]
        },
        {
          "partner_zh": "对。你能够自己找到吗？",
          "partner_en": "That's it. Can you find it on your own?",
          "prompt_en": "Say yes, and thank them for their help.",
          "answers_zh": [
            "能，谢谢你的帮助！",
            "没问题，谢谢！"
          ],
          "answers_en": [
            "Yes — thanks for your help!",
            "No problem, thanks!"
          ]
        }
      ],
      "closing_zh": "不客气！",
      "closing_en": "You're welcome!"
    },
    {
      "id": "2026-11-25-m2",
      "level": 2,
      "title": "Stuck on homework",
      "role": "同学",
      "goal": "Ask a classmate to help you finish today's homework.",
      "new_words": [
        {
          "word": "完成",
          "english": "to complete"
        },
        {
          "word": "求",
          "english": "to beg; to ask (a favour)"
        },
        {
          "word": "只要",
          "english": "as long as"
        }
      ],
      "steps": [
        {
          "partner_zh": "你怎么了？",
          "partner_en": "What's up?",
          "prompt_en": "Say you can't finish today's homework.",
          "answers_zh": [
            "今天的作业我完成不了。",
            "我不会做今天的作业。"
          ],
          "answers_en": [
            "I can't finish today's homework.",
            "I can't do today's homework."
          ]
        },
        {
          "partner_zh": "哪个地方不会？",
          "partner_en": "Which part can't you do?",
          "prompt_en": "Say the last part, and beg them to help.",
          "answers_zh": [
            "最后一个，求你帮帮我！",
            "最后的那个。求你了！"
          ],
          "answers_en": [
            "The last one — please help me!",
            "The last bit. I'm begging you!"
          ]
        },
        {
          "partner_zh": "好吧，只要你请我喝茶。",
          "partner_en": "Fine — as long as you buy me a tea.",
          "prompt_en": "Say no problem, two teas!",
          "answers_zh": [
            "没问题，请你喝两杯！",
            "好，我请你喝茶。"
          ],
          "answers_en": [
            "No problem — I'll buy you two!",
            "Deal, tea's on me."
          ]
        },
        {
          "partner_zh": "你看，这样写就可以了。",
          "partner_en": "Look, you just write it like this.",
          "prompt_en": "Say you get it now, thanks.",
          "answers_zh": [
            "我明白了，谢谢！",
            "原来是这样，谢谢你！"
          ],
          "answers_en": [
            "I get it now, thanks!",
            "Oh, so that's how — thank you!"
          ]
        }
      ],
      "closing_zh": "不客气，别忘了我的茶！",
      "closing_en": "You're welcome — don't forget my tea!"
    }
  ]
