  "missions": [
    {
      "id": "2026-10-11-m1",
      "level": 1,
      "title": "Buying a phone",
      "role": "店员",
      "goal": "Ask about a new phone, ask the price, look for a cheaper one and buy it.",
      "new_words": [
        { "word": "手机", "english": "mobile phone" },
        { "word": "今年", "english": "this year" }
      ],
      "steps": [
        {
          "partner_zh": "你好，想看什么？",
          "partner_en": "Hi, what are you looking for?",
          "prompt_en": "Say you want to buy a new phone.",
          "answers_zh": ["我想买一个新手机。", "我要买手机。"],
          "answers_en": ["I'd like to buy a new phone.", "I want to buy a phone."]
        },
        {
          "partner_zh": "这个怎么样？是今年最新的。",
          "partner_en": "How about this one? It's this year's newest model.",
          "prompt_en": "Ask how much it is.",
          "answers_zh": ["这个多少钱？", "多少钱？"],
          "answers_en": ["How much is this one?", "How much?"]
        },
        {
          "partner_zh": "五千块。",
          "partner_en": "5,000 kuai.",
          "prompt_en": "Say it's too expensive and ask for a cheaper one.",
          "answers_zh": ["太贵了，有便宜一点的吗？", "有没有便宜的？"],
          "answers_en": ["Too expensive. Is there a cheaper one?", "Do you have anything cheaper?"]
        },
        {
          "partner_zh": "这个三千，也很好。",
          "partner_en": "This one's 3,000 and it's good too.",
          "prompt_en": "Ask if you can try it.",
          "answers_zh": ["能试一下吗？", "我可以看看吗？"],
          "answers_en": ["Can I try it?", "Can I have a look?"]
        },
        {
          "partner_zh": "当然可以。",
          "partner_en": "Of course.",
          "prompt_en": "Say OK, you'll take this one.",
          "answers_zh": ["好，我要这个。", "就这个吧。"],
          "answers_en": ["OK, I'll take this one.", "This one, then."]
        }
      ],
      "closing_zh": "好的，这边付钱。",
      "closing_en": "OK, you can pay over here."
    },
    {
      "id": "2026-10-11-m2",
      "level": 1,
      "title": "A busy colleague",
      "role": "同事",
      "goal": "Find a time to talk to a busy colleague and check the time of tomorrow's meeting.",
      "new_words": [
        { "word": "忙", "english": "busy" },
        { "word": "马上", "english": "right away" }
      ],
      "steps": [
        {
          "partner_zh": "对不起，我现在很忙。",
          "partner_en": "Sorry, I'm really busy right now.",
          "prompt_en": "Ask when they'll be free.",
          "answers_zh": ["你什么时候有空？", "你几点有时间？"],
          "answers_en": ["When will you be free?", "What time are you free?"]
        },
        {
          "partner_zh": "十分钟以后吧。有什么事？",
          "partner_en": "In about ten minutes. What's it about?",
          "prompt_en": "Say you want to talk about tomorrow's meeting.",
          "answers_zh": ["我想跟你说一下明天的会。", "明天开会的事。"],
          "answers_en": ["I'd like to talk to you about tomorrow's meeting.", "It's about tomorrow's meeting."]
        },
        {
          "partner_zh": "好的，我马上就来。",
          "partner_en": "OK, I'll be right with you.",
          "prompt_en": "Say there's no hurry.",
          "answers_zh": ["不急，你先忙。", "没关系，慢慢来。"],
          "answers_en": ["No rush, carry on.", "That's fine, take your time."]
        },
        {
          "partner_zh": "好了，你说吧。",
          "partner_en": "Right, go ahead.",
          "prompt_en": "Ask if tomorrow's meeting is at 3 pm.",
          "answers_zh": ["明天的会是下午三点吗？", "会是三点吗？"],
          "answers_en": ["Is tomorrow's meeting at 3 pm?", "Is the meeting at three?"]
        },
        {
          "partner_zh": "不是，改到四点了。",
          "partner_en": "No, it's been moved to four.",
          "prompt_en": "Say OK, got it, thanks.",
          "answers_zh": ["好的，明白了，谢谢。", "知道了，谢谢！"],
          "answers_en": ["OK, got it, thanks.", "Understood, thanks!"]
        }
      ],
      "closing_zh": "不客气，明天见！",
      "closing_en": "You're welcome, see you tomorrow!"
    }
  ]
}
