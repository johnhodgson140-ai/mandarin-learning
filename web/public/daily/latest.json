          "prompt_en": "Say it's delicious.",
          "answers_zh": ["非常好吃！", "很好吃！"],
          "answers_en": ["Really delicious!", "Very tasty!"]
        },
        {
          "partner_zh": "还要吗？",
          "partner_en": "Would you like more?",
          "prompt_en": "Say yes, a little more.",
          "answers_zh": ["再来一点儿。", "要，谢谢！"],
          "answers_en": ["A little more, please.", "Yes please, thanks!"]
        }
      ],
      "closing_zh": "多吃点！",
      "closing_en": "Eat up!"
    }
  ]
