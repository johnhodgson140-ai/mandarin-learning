  "missions": [
    {
      "id": "2026-11-27-m1",
      "level": 2,
      "title": "A dropped phone",
      "role": "路人",
      "goal": "A passer-by tells you that you've dropped your phone. Thank them.",
      "new_words": [
        {
          "word": "掉",
          "english": "to drop; to fall"
        },
        {
          "word": "特别",
          "english": "especially"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！你的手机掉了。",
          "partner_en": "Excuse me! You dropped your phone.",
          "prompt_en": "Say oh no, where?",
          "answers_zh": [
            "啊！在哪儿？",
            "真的吗？在哪儿？"
          ],
          "answers_en": [
            "Oh! Where?",
            "Really? Where?"
          ]
        },
        {
          "partner_zh": "在地上，给你。",
          "partner_en": "On the ground — here you go.",
          "prompt_en": "Thank them very much.",
          "answers_zh": [
            "谢谢你！",
            "太谢谢你了！"
          ],
          "answers_en": [
            "Thank you!",
            "Thanks so much!"
          ]
        },
        {
          "partner_zh": "不客气。手机没坏吧？",
          "partner_en": "No problem. It's not broken, is it?",
          "prompt_en": "Say no, it's fine.",
          "answers_zh": [
            "没坏，没问题。",
            "没事儿，还能用。"
          ],
          "answers_en": [
            "No, it's fine.",
            "It's OK, still works."
          ]
        },
        {
          "partner_zh": "那就好。",
          "partner_en": "Good.",
          "prompt_en": "Say you're especially grateful, because all your photos are on it.",
          "answers_zh": [
            "特别谢谢你，我的照片都在里边。",
            "我特别高兴，里边有我所有的照片。"
          ],
          "answers_en": [
            "I'm especially grateful — all my photos are on it.",
            "I'm so relieved — all my photos are on there."
          ]
        }
      ],
      "closing_zh": "没事儿，下次小心！",
      "closing_en": "No worries — be careful next time!"
    },
    {
      "id": "2026-11-27-m2",
      "level": 2,
      "title": "Leaving the hotel",
      "role": "前台",
      "goal": "Check out of your hotel and ask them to call a taxi to the airport.",
      "new_words": [
        {
          "word": "离开",
          "english": "to leave"
        },
        {
          "word": "以前",
          "english": "before"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，你今天离开吗？",
          "partner_en": "Hello, are you leaving today?",
          "prompt_en": "Say yes, you're going to the airport.",
          "answers_zh": [
            "对，我要去机场。",
            "是的，今天走。"
          ],
          "answers_en": [
            "Yes, I'm going to the airport.",
            "Yes, I'm leaving today."
          ]
        },
        {
          "partner_zh": "好的。你的飞机几点？",
          "partner_en": "OK. What time is your flight?",
          "prompt_en": "Say at two in the afternoon.",
          "answers_zh": [
            "下午两点。",
            "两点的飞机。"
          ],
          "answers_en": [
            "Two in the afternoon.",
            "It's a two o'clock flight."
          ]
        },
        {
          "partner_zh": "你应该十二点以前离开。",
          "partner_en": "You should leave before twelve.",
          "prompt_en": "Ask them to call you a taxi.",
          "answers_zh": [
            "你能帮我叫车吗？",
            "请帮我打车，谢谢。"
          ],
          "answers_en": [
            "Could you call me a taxi?",
            "Please get me a taxi, thanks."
          ]
        },
        {
          "partner_zh": "没问题。车十分钟以后到门口。",
          "partner_en": "No problem. The car will be at the entrance in ten minutes.",
          "prompt_en": "Thank them and say you'll wait at the door.",
          "answers_zh": [
            "谢谢，我在门口等。",
            "好的，谢谢你。"
          ],
          "answers_en": [
            "Thanks, I'll wait at the entrance.",
            "Great, thank you."
          ]
        }
      ],
      "closing_zh": "不客气，欢迎下次再来！",
      "closing_en": "You're welcome — come again!"
    }
  ]
