      "title_zh": "少了两块",
      "title_en": "Two kuai short",
      "paragraphs": [
        ["今天", "我", "想", "喝", "水", "，", "就", "去", "买", "了", "。", "我", "问", "：", "“", "多少", "钱", "？", "”", "他", "说", "：", "“", "三", "块", "。", "”"],
