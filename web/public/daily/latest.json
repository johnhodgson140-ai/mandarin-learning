  "missions": [
    {
      "id": "2026-11-23-m1",
      "level": 2,
      "title": "Meeting a friend at the airport",
      "role": "朋友",
      "goal": "Pick your friend up from the airport and take them for food.",
      "new_words": [
        {
          "word": "接",
          "english": "to pick up (a person)"
        },
        {
          "word": "刚",
          "english": "just"
        },
        {
          "word": "以后",
          "english": "after"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好！你来接我了！",
          "partner_en": "Hi! You came to pick me up!",
          "prompt_en": "Say of course, and ask if they're tired.",
          "answers_zh": [
            "当然！你累不累？",
            "对啊！你累吗？"
          ],
          "answers_en": [
            "Of course! Are you tired?",
            "Yep! Are you tired?"
          ]
        },
        {
          "partner_zh": "有一点儿。我刚下飞机，很饿。",
          "partner_en": "A bit. I've just got off the plane and I'm starving.",
          "prompt_en": "Say let's go and eat first.",
          "answers_zh": [
            "我们先去吃饭吧。",
            "那先去吃饭！"
          ],
          "answers_en": [
            "Let's go and eat first.",
            "Food first, then!"
          ]
        },
        {
          "partner_zh": "好！吃饭以后去哪儿？",
          "partner_en": "Great! Where are we going after eating?",
          "prompt_en": "Say after eating you'll go back to your place.",
          "answers_zh": [
            "吃饭以后，我们回我家。",
            "以后回我家休息。"
          ],
          "answers_en": [
            "After we eat, we'll head back to mine.",
            "Then back to my place to rest."
          ]
        },
        {
          "partner_zh": "太好了，谢谢你！",
          "partner_en": "Brilliant, thank you!",
          "prompt_en": "Say no problem, let's go.",
          "answers_zh": [
            "不客气，走吧！",
            "没事儿，我们走吧。"
          ],
          "answers_en": [
            "No problem, let's go!",
            "No worries, let's go."
          ]
        }
      ],
      "closing_zh": "走！",
      "closing_en": "Let's go!"
    },
    {
      "id": "2026-11-23-m2",
      "level": 2,
      "title": "Making a plan",
      "role": "朋友",
      "goal": "Your friend wants to make a plan for Sunday. Agree on what to do.",
      "new_words": [
        {
          "word": "计划",
          "english": "plan"
        },
        {
          "word": "可是",
          "english": "but"
        },
        {
          "word": "全",
          "english": "whole; all"
        }
      ],
      "steps": [
        {
          "partner_zh": "星期天你有什么计划？",
          "partner_en": "What are your plans for Sunday?",
          "prompt_en": "Say you don't have a plan yet.",
          "answers_zh": [
            "我还没有计划。",
            "没有计划。"
          ],
          "answers_en": [
            "I don't have any plans yet.",
            "No plans."
          ]
        },
        {
          "partner_zh": "我们去看电影吧？",
          "partner_en": "Shall we go and see a film?",
          "prompt_en": "Say you'd like to, but you have to study in the morning.",
          "answers_zh": [
            "想去，可是上午我要学习。",
            "可以，可是上午不行。"
          ],
          "answers_en": [
            "I'd love to, but I have to study in the morning.",
            "Sure, but not in the morning."
          ]
        },
        {
          "partner_zh": "那下午去，好吗？",
          "partner_en": "Afternoon then, OK?",
          "prompt_en": "Say afternoon is fine, and ask if your other friends are coming.",
          "answers_zh": [
            "下午可以。大家都去吗？",
            "好，下午去。还有谁去？"
          ],
          "answers_en": [
            "Afternoon's fine. Is everyone going?",
            "OK, afternoon. Who else is going?"
          ]
        },
        {
          "partner_zh": "全班同学都去！",
          "partner_en": "The whole class is going!",
          "prompt_en": "Say great, see you on Sunday.",
          "answers_zh": [
            "太好了，星期天见！",
            "好，星期天见！"
          ],
          "answers_en": [
            "Brilliant, see you Sunday!",
            "OK, see you Sunday!"
          ]
        }
      ],
      "closing_zh": "星期天见！",
      "closing_en": "See you Sunday!"
    }
  ]
