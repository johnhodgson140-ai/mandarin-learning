      "title": "On the train",
      "role": "乘客",
      "goal": "Find your seat, check the train goes to Shanghai and chat with the passenger next to you.",
      "new_words": [
        { "word": "火车", "english": "train" },
        { "word": "右边", "english": "on the right" },
        { "word": "上次", "english": "last time" }
      ],
      "steps": [
        {
          "partner_zh": "你好，你找什么？",
          "partner_en": "Hi, are you looking for something?",
          "prompt_en": "Say you're looking for seat 12.",
          "answers_zh": ["我找十二号座位。", "请问十二号在哪儿？"],
          "answers_en": ["I'm looking for seat 12.", "Excuse me, where's number 12?"]
        },
        {
          "partner_zh": "十二号在右边，靠窗。",
          "partner_en": "Number 12 is on the right, by the window.",
          "prompt_en": "Say thanks, and ask if this is the train to Shanghai.",
          "answers_zh": ["谢谢。这是去上海的火车吗？", "这火车到上海吗？"],
          "answers_en": ["Thanks. Is this the train to Shanghai?", "Does this train go to Shanghai?"]
        },
        {
          "partner_zh": "对，下午三点到。",
          "partner_en": "Yes, it gets in at three this afternoon.",
          "prompt_en": "Ask if they're going to Shanghai too.",
          "answers_zh": ["你也去上海吗？", "你也到上海吗？"],
          "answers_en": ["Are you going to Shanghai too?", "Are you getting off at Shanghai too?"]
        },
        {
          "partner_zh": "是啊，我回家。上次我坐了八个小时！",
          "partner_en": "Yes, I'm going home. Last time it took me eight hours!",
          "prompt_en": "Say today it's only four hours.",
          "answers_zh": ["今天只要四个小时。", "今天快多了。"],
          "answers_en": ["Today it's only four hours.", "Today's much quicker."]
        },
        {
          "partner_zh": "对！你要喝点水吗？",
          "partner_en": "That's right! Would you like some water?",
          "prompt_en": "Say no thanks.",
          "answers_zh": ["不用了，谢谢。", "谢谢，不用。"],
          "answers_en": ["No need, thanks.", "Thanks, I'm fine."]
        }
      ],
      "closing_zh": "好的，路上开心！",
      "closing_en": "OK, enjoy the journey!"
    },
