        { "word": "认识", "english": "to know; to meet (someone)" },
        { "word": "学校", "english": "school" },
        { "word": "明天", "english": "tomorrow" }
      ],
      "steps": [
        {
          "partner_zh": "你好！我叫小王。",
          "partner_en": "Hi! I'm Xiao Wang.",
          "prompt_en": "Say hi and that you're happy to meet them.",
          "answers_zh": ["你好！很高兴认识你。", "认识你很高兴！"],
          "answers_en": ["Hi! Nice to meet you.", "Great to meet you!"]
        },
        {
          "partner_zh": "你是哪国人？",
          "partner_en": "Where are you from?",
          "prompt_en": "Say you're British.",
          "answers_zh": ["我是英国人。", "我从英国来。"],
          "answers_en": ["I'm British.", "I'm from the UK."]
        },
        {
          "partner_zh": "你在哪个学校学习？",
          "partner_en": "Which school do you study at?",
          "prompt_en": "Say your school is in London.",
          "answers_zh": ["我的学校在伦敦。", "我在伦敦的大学学习。"],
          "answers_en": ["My school is in London.", "I study at a university in London."]
        },
        {
          "partner_zh": "你喜欢做什么？",
          "partner_en": "What do you like doing?",
          "prompt_en": "Say you like watching football.",
          "answers_zh": ["我喜欢看足球。", "我很喜欢足球。"],
          "answers_en": ["I like watching football.", "I really like football."]
        },
        {
          "partner_zh": "我也是！明天我们一起去看比赛吧？",
          "partner_en": "Me too! Shall we go and watch a match together tomorrow?",
          "prompt_en": "Say great, see you tomorrow.",
          "answers_zh": ["好啊，明天见！", "好的，明天见！"],
          "answers_en": ["Sure, see you tomorrow!", "OK, see you tomorrow!"]
        }
      ],
      "closing_zh": "太好了，明天见！",
      "closing_en": "Great, see you tomorrow!"
    }
  ]
