    {
      "id": "2026-10-18-s1",
      "level": 1,
      "topic": "anime",
      "title_zh": "我哥学动作",
      "title_en": "My brother copies the moves",
      "paragraphs": [
        ["昨天", "晚上", "，", "我", "和", "我", "哥", "一起", "看", "了", "一", "个", "日本", "电影", "。", "我们", "都", "很", "喜欢", "这", "个", "电影", "。"],
        ["电影", "里", "的", "人", "动作", "非常", "快", "。"],
        ["我", "哥", "一边", "看", "，", "一边", "学", "他们", "的", "动作", "。"],
        ["他", "跑", "来", "跑", "去", "，", "杯", "里", "的", "水", "都", "出来", "了", "！"],
        ["妈妈", "说", "：", "“", "别", "动", "了", "！", "坐", "下", "！", "”", "我们", "都", "笑", "了", "。"]
      ],
      "translations": [
        "Yesterday evening my older brother and I watched a Japanese film together. We both really liked it.",
        "The people in the film moved really fast.",
        "My brother copied their moves while he watched.",
        "He ran all over the place, and the water spilled out of the cup!",
        "Mum said: “Stop moving! Sit down!” We all laughed."
      ],
      "names": ["日本"],
      "new_words": ["动作", "一边"],
      "glossary": [
        { "word": "动作", "english": "movement; action" },
        { "word": "一边", "english": "while (一边…一边…: doing two things at once)" },
        { "word": "日本", "english": "Japan" }
      ]
    },
    {
      "id": "2026-10-18-s2",
      "level": 1,
      "topic": "travel",
      "title_zh": "没有热水",
      "title_en": "No hot water",
      "paragraphs": [
        ["上", "个", "月", "，", "我", "和", "爸爸", "去", "上海", "。", "我们", "住", "在", "一", "个", "小", "地方", "。"],
        ["房间", "不", "大", "，", "也", "有些", "老", "。", "房间", "里", "有", "一", "个", "电视", "。"],
        ["晚上", "，", "我", "想", "洗", "手", "，", "水", "是", "冷", "的", "！"],
        ["我", "给", "他们", "打", "电话", "。", "他们", "说", "：", "“", "对", "，", "热", "水", "坏", "了", "。", "”"],
        ["他们", "给", "了", "我们", "一", "个", "新", "房间", "。", "爸爸", "笑", "着", "说", "：", "“", "有", "热", "水", "真", "好", "！", "”"]
      ],
      "translations": [
        "Last month Dad and I went to Shanghai. We stayed somewhere small.",
        "The room wasn’t big, and it was a bit old. There was a TV in the room.",
        "In the evening I wanted to wash my hands, but the water was cold!",
        "I phoned them. They said: “Yes, the hot water is broken.”",
        "They gave us a new room. Dad smiled and said: “Hot water — how nice!”"
      ],
      "names": ["上海"],
      "new_words": ["房间", "洗", "坏"],
      "glossary": [
        { "word": "房间", "english": "room" },
        { "word": "洗", "english": "to wash" },
        { "word": "坏", "english": "broken" },
        { "word": "上海", "english": "Shanghai" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-18-m1",
      "level": 1,
      "title": "At a fruit stall",
      "role": "老板",
      "goal": "Buy apples and bananas, follow prices in 块 and 毛, and round the total down.",
      "new_words": [
        { "word": "毛", "english": "mao (ten cents)" },
        { "word": "七", "english": "seven" },
        { "word": "八", "english": "eight" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要点什么？",
          "partner_en": "Hi, what would you like?",
          "prompt_en": "Ask how much the apples are.",
          "answers_zh": ["苹果怎么卖？", "苹果多少钱一斤？"],
          "answers_en": ["How much are the apples?", "How much is a jin of apples?"]
        },
        {
          "partner_zh": "三块八毛一斤。",
          "partner_en": "3.80 a jin.",
          "prompt_en": "Say you'll have two jin.",
          "answers_zh": ["我要两斤。", "来两斤吧。"],
          "answers_en": ["I'll have two jin.", "Two jin, please."]
        },
        {
          "partner_zh": "好的。还要别的吗？",
          "partner_en": "OK. Anything else?",
          "prompt_en": "Ask for some bananas too.",
          "answers_zh": ["还要一些香蕉。", "再要点香蕉。"],
          "answers_en": ["Some bananas too.", "And some bananas, please."]
        },
        {
          "partner_zh": "香蕉七块。一共十四块六毛。",
          "partner_en": "The bananas are 7. That's 14.60 altogether.",
          "prompt_en": "Ask if 14 is OK.",
          "answers_zh": ["十四块可以吗？", "给你十四块，行吗？"],
          "answers_en": ["Is 14 OK?", "Here's 14 — will that do?"]
        },
        {
          "partner_zh": "行，十四块吧。",
          "partner_en": "Fine, 14 it is.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢老板！", "好的，谢谢！"],
          "answers_en": ["Thanks!", "OK, thank you!"]
        }
      ],
      "closing_zh": "不客气，慢走！",
      "closing_en": "You're welcome, take care!"
    },
    {
      "id": "2026-10-18-m2",
      "level": 1,
      "title": "Inviting a friend to dinner",
      "role": "朋友",
      "goal": "Phone a friend, invite them to dinner tonight and agree the time and place.",
      "new_words": [
        { "word": "吃饭", "english": "to eat a meal" },
        { "word": "忘记", "english": "to forget" },
        { "word": "左", "english": "left" }
      ],
      "steps": [
        {
          "partner_zh": "喂？",
          "partner_en": "Hello?",
          "prompt_en": "Ask if they'd like to have dinner together tonight.",
          "answers_zh": ["今天晚上一起吃饭吧？", "你今天晚上有空吗？一起吃饭吧。"],
          "answers_en": ["Shall we have dinner together tonight?", "Are you free tonight? Let's have dinner."]
        },
        {
          "partner_zh": "好啊！几点？",
          "partner_en": "Sure! What time?",
          "prompt_en": "Say seven.",
          "answers_zh": ["七点吧。", "晚上七点。"],
          "answers_en": ["Seven.", "Seven this evening."]
        },
        {
          "partner_zh": "在哪里？",
          "partner_en": "Where?",
          "prompt_en": "Say at the restaurant to the left of the metro station.",
          "answers_zh": ["在地铁站左边的饭馆。", "地铁站左边那家。"],
          "answers_en": ["At the restaurant to the left of the metro station.", "The one on the left of the metro station."]
        },
        {
          "partner_zh": "好的，别忘记给我发地址。",
          "partner_en": "OK, don't forget to send me the address.",
          "prompt_en": "Say OK, you'll send it now.",
          "answers_zh": ["好，我现在就发。", "没问题，马上发给你。"],
          "answers_en": ["OK, I'll send it now.", "No problem, sending it right away."]
        },
        {
          "partner_zh": "好，晚上见！",
          "partner_en": "Great, see you tonight!",
          "prompt_en": "Say see you at seven.",
          "answers_zh": ["好，七点见！", "晚上见！"],
          "answers_en": ["OK, see you at seven!", "See you tonight!"]
        }
      ],
      "closing_zh": "到时候见！",
      "closing_en": "See you then!"
    }
  ]
}
