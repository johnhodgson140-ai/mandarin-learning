    {
      "id": "2026-10-02-s1",
      "level": 1,
      "topic": "daily life",
      "title_zh": "我的一天",
      "title_en": "My day",
      "paragraphs": [
        ["今天", "我", "六", "点", "就", "起来", "了", "。", "我", "先", "吃", "了", "点", "东西", "。"],
        ["七", "点", "，", "我", "去", "工作", "。", "今天", "的", "工作", "非常", "多", "，", "也", "很", "重要", "。", "我", "跟", "朋友", "一起", "工作", "，", "他们", "人", "都", "很", "好", "。"],
        ["我", "五", "点", "回", "家", "。", "孩子", "说", "：", "“", "我们", "一起", "玩", "吧", "！", "”", "我们", "玩", "了", "一", "个", "小时", "，", "孩子", "笑", "了", "。"],
        ["十", "点", "，", "我", "就", "睡", "了", "。", "明天", "还", "要", "工作", "呢", "！"]
      ],
      "translations": [
        "Today I got up at six. First I ate a little something.",
        "At seven I went to work. There was a lot of work today, and it was important. I work with friends, and they’re all really nice.",
        "I got home at five. My child said: “Let’s play together!” We played for an hour, and my child laughed.",
        "At ten I went to sleep. I have to work again tomorrow!"
      ],
      "names": [],
      "new_words": ["玩", "睡", "明天"],
      "glossary": [
        { "word": "玩", "english": "to play; to have fun" },
        { "word": "睡", "english": "to sleep" },
        { "word": "明天", "english": "tomorrow" }
      ]
    },
    {
      "id": "2026-10-02-s2",
      "level": 1,
      "topic": "business & finance",
      "title_zh": "我的钱",
      "title_en": "My money",
      "paragraphs": [
        ["这", "个", "月", "，", "我", "花", "了", "很", "多", "钱", "。"],
        ["我", "买", "了", "很", "多", "新", "东西", "，", "还", "送", "了", "朋友", "一些", "东西", "。"],
        ["现在", "，", "我", "没有", "钱", "了", "！", "我", "去", "找", "朋友", "，", "问", "他", "怎么", "做", "。"],
        ["朋友", "告诉", "我", "：", "“", "别", "花", "太", "多", "钱", "。", "买", "东西", "前", "，", "先", "想", "一", "想", "：", "这", "个", "重要", "吗", "？", "”"],
        ["他", "说", "的", "话", "很", "对", "。", "下", "个", "月", "，", "我", "要", "先", "想", "，", "再", "买", "。"]
      ],
      "translations": [
        "This month I spent a lot of money.",
        "I bought lots of new things, and I also gave my friends some things.",
        "Now I have no money left! I went to find a friend and asked him what to do.",
        "My friend told me: “Don’t spend too much. Before you buy something, think first: is it important?”",
        "What he said is right. Next month I’ll think first, then buy."
      ],
      "names": [],
      "new_words": ["花"],
      "glossary": [
        { "word": "花", "english": "to spend (money, time)" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-10-02-m1",
      "level": 1,
      "title": "Ordering at a café",
      "role": "店员",
      "goal": "Order a coffee, choose the size, say you'll drink it here and find a seat.",
      "new_words": [
        { "word": "喝", "english": "to drink" },
        { "word": "坐", "english": "to sit" }
      ],
      "steps": [
        {
          "partner_zh": "你好！想喝什么？",
          "partner_en": "Hi! What would you like to drink?",
          "prompt_en": "Ask for a coffee.",
          "answers_zh": ["我要一杯咖啡。", "一杯咖啡，谢谢。"],
          "answers_en": ["I'd like a coffee.", "A coffee, please."]
        },
        {
          "partner_zh": "要大杯还是小杯？",
          "partner_en": "Large or small?",
          "prompt_en": "Say large.",
          "answers_zh": ["大杯。", "要大杯的。"],
          "answers_en": ["Large.", "A large one."]
        },
        {
          "partner_zh": "在这里喝还是带走？",
          "partner_en": "To drink here or to take away?",
          "prompt_en": "Say you'll drink it here.",
          "answers_zh": ["在这里喝。", "我在这里喝。"],
          "answers_en": ["Drink here.", "I'll drink it here."]
        },
        {
          "partner_zh": "好的，一共二十八块。",
          "partner_en": "OK, that's 28 yuan altogether.",
          "prompt_en": "Ask if you can sit here.",
          "answers_zh": ["我可以坐这里吗？", "我能坐这里吗？"],
          "answers_en": ["Can I sit here?", "May I sit here?"]
        },
        {
          "partner_zh": "随便坐。咖啡好了我给你送过去。",
          "partner_en": "Sit anywhere. I'll bring the coffee over when it's ready.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["好的，谢谢！", "谢谢你！"],
          "answers_en": ["OK, thanks!", "Thank you!"]
        }
      ],
      "closing_zh": "不客气，请慢用！",
      "closing_en": "You're welcome, enjoy!"
    },
    {
      "id": "2026-10-02-m2",
      "level": 1,
      "title": "Meeting someone new",
      "role": "新朋友",
      "goal": "Say hello, say where you're from and where you study, talk about what you like, and make a plan for tomorrow.",
