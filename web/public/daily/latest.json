      "new_words": [
        { "word": "开车", "english": "to drive" },
        { "word": "这边", "english": "this way; over here" },
        { "word": "门口", "english": "entrance; doorway" }
      ],
      "steps": [
        {
          "partner_zh": "你开车来的吗？",
          "partner_en": "Did you drive here?",
          "prompt_en": "Say yes, you drove.",
          "answers_zh": ["对，我开车来的。", "是的，我开车来了。"],
          "answers_en": ["Yes, I drove.", "Yes, I came by car."]
        },
        {
          "partner_zh": "你能送我回家吗？",
          "partner_en": "Could you give me a lift home?",
          "prompt_en": "Say sure, and ask where they live.",
          "answers_zh": ["可以，你住哪儿？", "没问题，你家在哪儿？"],
          "answers_en": ["Sure, where do you live?", "No problem — where's your place?"]
        },
        {
          "partner_zh": "我家在火车站那边。",
          "partner_en": "I live over by the train station.",
          "prompt_en": "Say OK, your car is this way.",
          "answers_zh": ["好，我的车在这边。", "走吧，车在这边。"],
          "answers_en": ["OK, my car is this way.", "Come on, the car's over here."]
        },
        {
          "partner_zh": "你的车在门口吗？",
          "partner_en": "Is your car by the entrance?",
          "prompt_en": "Say yes, right by the entrance.",
          "answers_zh": ["对，就在门口。", "是的，在门口。"],
          "answers_en": ["Yes, right by the entrance.", "Yes, by the door."]
        },
        {
          "partner_zh": "太好了，谢谢你！",
          "partner_en": "Great, thank you!",
          "prompt_en": "Say no problem.",
          "answers_zh": ["没问题！", "不客气。"],
          "answers_en": ["No problem!", "You're welcome."]
        }
      ],
      "closing_zh": "我们走吧！",
      "closing_en": "Let's go!"
    },
