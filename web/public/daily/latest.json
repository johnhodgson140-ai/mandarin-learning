    {
      "id": "2026-11-09-s1",
      "level": 1,
      "topic": "daily life",
      "title_zh": "书包在哪儿？",
      "title_en": "Where's the schoolbag?",
      "paragraphs": [
        ["我", "弟", "是", "小学生", "，", "今年", "八", "岁", "。", "今天", "早上", "，", "他", "找", "不", "到", "他", "的", "书包", "了", "。"],
        ["他", "在", "家里", "找", "了", "半天", "，", "都", "没有", "找到", "。"],
        ["妈妈", "说", "：", "“", "你", "看", "看", "外边", "！", "”", "就", "在", "门", "外", "！"],
        ["昨天", "他", "放学", "回家", "，", "忘", "了", "拿", "进来", "。"],
        ["弟弟", "笑", "了", "：", "“", "下次", "我", "会", "记住", "的", "！", "”", "妈妈", "也", "笑", "了", "。"]
      ],
      "translations": [
        "My little brother is at primary school — he's eight this year. This morning he couldn't find his schoolbag.",
        "He searched the house for ages and couldn't find it anywhere.",
        "Mum said: “Have a look outside!” It was right outside the door!",
        "When he came home from school yesterday, he forgot to bring it in.",
        "My brother laughed: “I’ll remember next time!” Mum laughed too."
      ],
      "names": [],
      "new_words": ["小学生", "书包", "外边"],
      "glossary": [
        { "word": "小学生", "english": "primary-school pupil" },
        { "word": "书包", "english": "schoolbag" },
        { "word": "外边", "english": "outside" }
      ]
    },
    {
      "id": "2026-11-09-s2",
      "level": 1,
      "topic": "business & finance",
      "title_zh": "网上教中文",
      "title_en": "Teaching Chinese online",
      "paragraphs": [
        ["我", "的", "朋友", "会", "说", "很", "多", "外语", "。", "她", "没事儿", "的", "时候", "，", "在", "网上", "教", "别人", "中文", "。"],
        ["一", "个", "小时", "，", "她", "能", "得到", "一百", "块", "。"],
        ["我", "问", "她", "：", "“", "你", "一", "个", "月", "能", "得到", "多少", "钱", "？", "”"],
        ["她", "说", "：", "“", "有时候", "多", "，", "有时候", "少", "。", "我", "很", "喜欢", "这", "个", "工作", "。", "”"],
        ["我", "觉得", "这", "个", "工作", "很", "好", "。", "我", "也", "想", "试", "一", "试", "！"]
      ],
      "translations": [
        "My friend speaks lots of foreign languages. When she's free, she teaches Chinese online.",
        "She can earn a hundred kuai an hour.",
        "I asked her: “How much can you make in a month?”",
        "She said: “Sometimes more, sometimes less. I really like the work.”",
        "I think it’s a great job. I want to give it a go too!"
      ],
      "names": [],
      "new_words": ["外语", "没事儿"],
      "glossary": [
        { "word": "外语", "english": "foreign language" },
        { "word": "没事儿", "english": "to be free; have nothing on" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-11-09-m1",
      "level": 1,
      "title": "At the bakery",
      "role": "店员",
      "goal": "Buy a piece of bread, choose the size, say it's to take away and pay.",
      "new_words": [
        { "word": "一块儿", "english": "a piece" },
        { "word": "里边", "english": "inside" }
      ],
      "steps": [
        {
          "partner_zh": "你好，要什么？",
          "partner_en": "Hi, what would you like?",
          "prompt_en": "Ask for a piece of this bread.",
          "answers_zh": ["我要一块儿这个面包。", "给我一块儿面包。"],
          "answers_en": ["I'd like a piece of this bread.", "A piece of bread, please."]
        },
        {
          "partner_zh": "要大的还是小的？",
          "partner_en": "Big or small?",
          "prompt_en": "Say small.",
          "answers_zh": ["要小的。", "小的。"],
          "answers_en": ["A small one.", "Small."]
        },
        {
          "partner_zh": "在里边吃还是带走？",
          "partner_en": "Eating in or taking away?",
          "prompt_en": "Say take away.",
          "answers_zh": ["我带走。", "带走。"],
          "answers_en": ["I'll take it away.", "Take away."]
        },
        {
          "partner_zh": "好的，八块。",
          "partner_en": "OK, eight kuai.",
          "prompt_en": "Say you'll pay by phone.",
          "answers_zh": ["我用手机给。", "可以用手机吗？"],
          "answers_en": ["I'll pay by phone.", "Can I pay by phone?"]
        }
      ],
      "closing_zh": "可以，谢谢！",
      "closing_en": "Sure, thank you!"
    },
    {
      "id": "2026-11-09-m2",
      "level": 1,
      "title": "A language swap",
      "role": "中学生",
      "goal": "Chat with a secondary-school student you're doing a language swap with: their exam, your languages, and how you'll help each other.",
      "new_words": [
        { "word": "中学生", "english": "secondary-school student" },
        { "word": "外语", "english": "foreign language" }
      ],
      "steps": [
        {
          "partner_zh": "你好！我是中学生小明。",
          "partner_en": "Hi! I'm Xiao Ming, I'm at secondary school.",
          "prompt_en": "Say hello and ask how school was today.",
          "answers_zh": ["你好！今天学校怎么样？", "你好，今天好吗？"],
          "answers_en": ["Hi! How was school today?", "Hi, how was today?"]
        },
        {
          "partner_zh": "还行。今天有英语考试。",
          "partner_en": "Not bad. We had an English exam today.",
          "prompt_en": "Ask if it was hard.",
          "answers_zh": ["考试难不难？", "难吗？"],
          "answers_en": ["Was the exam hard?", "Was it hard?"]
        },
        {
          "partner_zh": "有一点儿难。你会说几门外语？",
          "partner_en": "A bit hard. How many foreign languages can you speak?",
          "prompt_en": "Say English and a little Chinese.",
          "answers_zh": ["我会说英语，也会一点儿中文。", "英语和一点儿中文。"],
          "answers_en": ["I speak English, and a bit of Chinese.", "English and a little Chinese."]
        },
        {
          "partner_zh": "你中文说得很好！",
          "partner_en": "Your Chinese is really good!",
          "prompt_en": "Say thanks — they teach you Chinese, you teach them English.",
          "answers_zh": ["谢谢！你教我中文，我教你英语。", "谢谢，我还在学。我们一起学吧！"],
          "answers_en": ["Thanks! You teach me Chinese, I'll teach you English.", "Thanks, I'm still learning. Let's learn together!"]
        },
        {
          "partner_zh": "好啊！",
          "partner_en": "Sounds good!",
          "prompt_en": "Say great, let's start.",
          "answers_zh": ["太好了，我们开始吧！", "好，开始吧！"],
          "answers_en": ["Great, let's start!", "OK, let's begin!"]
        }
      ],
      "closing_zh": "开始吧！",
      "closing_en": "Let's start!"
    }
  ]
