  "missions": [
    {
      "id": "2026-11-04-m1",
      "level": 1,
      "title": "Lunch with a colleague",
      "role": "同事",
      "goal": "Agree to have lunch with a colleague, choose what to eat and chat about your hobbies.",
      "new_words": [
        { "word": "午饭", "english": "lunch" },
        { "word": "爱好", "english": "hobby" }
      ],
      "steps": [
        {
          "partner_zh": "中午一起吃午饭吧？",
          "partner_en": "Shall we have lunch together at midday?",
          "prompt_en": "Say sure, and ask where.",
          "answers_zh": ["好啊，去哪儿吃？", "好，在哪儿吃？"],
          "answers_en": ["Sure, where shall we go?", "OK, where?"]
        },
        {
          "partner_zh": "楼下的饭店怎么样？",
          "partner_en": "How about the restaurant downstairs?",
          "prompt_en": "Say good, the food there is tasty.",
          "answers_zh": ["好，那里很好吃。", "好啊。"],
          "answers_en": ["Good — the food there is tasty.", "Sure."]
        },
        {
          "partner_zh": "你想吃什么？",
          "partner_en": "What do you fancy?",
          "prompt_en": "Say noodles.",
          "answers_zh": ["我想吃面条。", "来一碗面。"],
          "answers_en": ["I'd like noodles.", "A bowl of noodles."]
        },
        {
          "partner_zh": "你有什么爱好？",
          "partner_en": "What are your hobbies?",
          "prompt_en": "Say watching films.",
          "answers_zh": ["我的爱好是看电影。", "我喜欢看电影。"],
          "answers_en": ["My hobby is watching films.", "I like watching films."]
        },
        {
          "partner_zh": "我也是！下次一起去看吧。",
          "partner_en": "Me too! Let's go and watch one together next time.",
          "prompt_en": "Say great.",
          "answers_zh": ["太好了！", "好啊，下次一起去！"],
          "answers_en": ["Great!", "Sure, let's go next time!"]
        }
      ],
      "closing_zh": "走吧，吃饭去！",
      "closing_en": "Come on, let's go and eat!"
    },
    {
      "id": "2026-11-04-m2",
      "level": 1,
      "title": "Helping a child in the park",
      "role": "小朋友",
      "goal": "A child's ball is stuck in a tree: find out which tree, get it down and ask how old they are.",
      "new_words": [
        { "word": "左边", "english": "on the left" },
        { "word": "小朋友", "english": "child (friendly way to address a kid)" }
      ],
      "steps": [
        {
          "partner_zh": "你好！你能帮我吗？",
          "partner_en": "Hello! Can you help me?",
          "prompt_en": "Say of course, what's wrong?",
          "answers_zh": ["当然，怎么了？", "好啊，有什么事？"],
          "answers_en": ["Of course, what's the matter?", "Sure, what is it?"]
        },
        {
          "partner_zh": "我的球在树上。",
          "partner_en": "My ball is stuck in a tree.",
          "prompt_en": "Ask which tree.",
          "answers_zh": ["哪个树？", "是哪一棵树？"],
          "answers_en": ["Which tree?", "Which tree is it?"]
        },
        {
          "partner_zh": "左边那个大树。",
          "partner_en": "The big one on the left.",
          "prompt_en": "Say OK, you'll get it.",
          "answers_zh": ["好，我帮你拿。", "好，我去拿。"],
          "answers_en": ["OK, I'll get it for you.", "OK, I'll fetch it."]
        },
        {
          "partner_zh": "谢谢！你真好！",
          "partner_en": "Thank you! You're so kind!",
          "prompt_en": "Say no problem, and ask the child how old they are.",
          "answers_zh": ["不客气。小朋友，你几岁了？", "没事。你几岁了？"],
          "answers_en": ["You're welcome. How old are you, little one?", "No problem. How old are you?"]
        },
        {
          "partner_zh": "我六岁了！",
          "partner_en": "I'm six!",
          "prompt_en": "Say have fun, and be careful.",
          "answers_zh": ["玩得开心，小心点！", "好好玩！"],
          "answers_en": ["Have fun, and be careful!", "Enjoy yourself!"]
        }
      ],
      "closing_zh": "谢谢！拜拜！",
      "closing_en": "Thanks! Bye-bye!"
    }
  ]
}
