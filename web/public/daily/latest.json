  "missions": [
    {
      "id": "2026-10-10-m1",
      "level": 1,
      "title": "Calling in sick",
      "role": "经理",
      "goal": "Tell your manager you're ill, say you'll see a doctor and agree when you'll call back.",
      "new_words": [
        { "word": "病", "english": "ill; illness" },
        { "word": "医生", "english": "doctor" }
      ],
      "steps": [
        {
          "partner_zh": "喂，你好。",
          "partner_en": "Hello?",
          "prompt_en": "Say hello and that you're ill today.",
          "answers_zh": ["你好，我今天病了。", "喂，我生病了。"],
          "answers_en": ["Hi, I'm ill today.", "Hello, I'm sick."]
        },
        {
          "partner_zh": "怎么了？",
          "partner_en": "What's wrong?",
          "prompt_en": "Say you have a fever.",
          "answers_zh": ["我发烧了。", "我有点发烧。"],
          "answers_en": ["I've got a fever.", "I have a bit of a temperature."]
        },
        {
          "partner_zh": "你去看医生了吗？",
          "partner_en": "Have you been to see a doctor?",
          "prompt_en": "Say you're going this afternoon.",
          "answers_zh": ["我下午去看医生。", "下午就去。"],
          "answers_en": ["I'm seeing a doctor this afternoon.", "I'm going this afternoon."]
        },
        {
          "partner_zh": "好，你好好休息。明天能来吗？",
          "partner_en": "OK, get some rest. Can you come in tomorrow?",
          "prompt_en": "Say you'll call tomorrow morning.",
          "answers_zh": ["我明天早上给你打电话。", "明天早上告诉你。"],
          "answers_en": ["I'll call you tomorrow morning.", "I'll let you know tomorrow morning."]
        },
        {
          "partner_zh": "没问题，身体最重要。",
          "partner_en": "No problem, your health comes first.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢你！", "好的，谢谢！"],
          "answers_en": ["Thank you!", "OK, thanks!"]
        }
      ],
      "closing_zh": "不客气，早点好起来！",
      "closing_en": "You're welcome. Get well soon!"
    },
    {
      "id": "2026-10-10-m2",
      "level": 1,
      "title": "Meeting friends at a party",
      "role": "朋友",
      "goal": "Say hello to your friend's classmates, tell them your name and how you know your friend, and agree to sing together.",
      "new_words": [
        { "word": "介绍", "english": "to introduce" },
        { "word": "她们", "english": "they (for women)" },
        { "word": "名字", "english": "name" }
      ],
      "steps": [
        {
          "partner_zh": "来，我给你介绍一下。她们是我的同学。",
          "partner_en": "Come, let me introduce you. These are my classmates.",
          "prompt_en": "Say hello to everyone.",
          "answers_zh": ["你们好！", "大家好！"],
          "answers_en": ["Hi, all of you!", "Hello, everyone!"]
        },
        {
          "partner_zh": "她叫小红，她叫小美。",
          "partner_en": "This is Xiao Hong, and this is Xiao Mei.",
          "prompt_en": "Say nice to meet them.",
          "answers_zh": ["认识你们很高兴！", "很高兴认识你们。"],
          "answers_en": ["Great to meet you!", "Nice to meet you."]
        },
        {
          "partner_zh": "你叫什么名字？",
          "partner_en": "What's your name?",
          "prompt_en": "Say your Chinese name is An De.",
          "answers_zh": ["我的中文名字叫安德。", "我叫安德。"],
          "answers_en": ["My Chinese name is An De.", "I'm An De."]
        },
        {
          "partner_zh": "你们是怎么认识的？",
          "partner_en": "How do you two know each other?",
          "prompt_en": "Say you were at university together.",
          "answers_zh": ["我们是大学同学。", "我们在大学认识的。"],
          "answers_en": ["We were at university together.", "We met at university."]
        },
        {
          "partner_zh": "等一下我们一起唱歌吧！",
          "partner_en": "Let's all sing together in a bit!",
          "prompt_en": "Say OK, but you don't sing well.",
          "answers_zh": ["好啊，可是我唱得不好。", "好！我唱得不太好。"],
          "answers_en": ["Sure, but I'm not a good singer.", "OK! I don't sing very well."]
        }
      ],
      "closing_zh": "没关系，一起唱就好！",
      "closing_en": "Never mind, as long as we sing together!"
    }
  ]
