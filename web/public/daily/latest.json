    {
      "id": "2026-10-25-m1",
      "level": 1,
      "title": "Picking a friend up at the airport",
      "role": "朋友",
      "goal": "Your friend has landed: say you're on the way, how long you'll be and where to wait.",
      "new_words": [
        { "word": "机场", "english": "airport" },
        { "word": "九", "english": "nine" },
        { "word": "一会儿", "english": "in a moment" }
      ],
      "steps": [
        {
          "partner_zh": "喂，我到机场了！",
          "partner_en": "Hi, I've landed at the airport!",
          "prompt_en": "Say great, you're on your way.",
          "answers_zh": ["太好了，我在路上了。", "好，我马上到。"],
          "answers_en": ["Great, I'm on my way.", "OK, I'll be right there."]
        },
        {
          "partner_zh": "你多长时间能到？",
          "partner_en": "How long will you be?",
          "prompt_en": "Say about twenty minutes.",
          "answers_zh": ["二十分钟左右。", "大概二十分钟。"],
          "answers_en": ["About twenty minutes.", "Roughly twenty minutes."]
        },
        {
          "partner_zh": "我在哪里等你？",
          "partner_en": "Where should I wait for you?",
          "prompt_en": "Say wait at exit 9.",
          "answers_zh": ["你在九号门等我。", "在九号出口等我吧。"],
          "answers_en": ["Wait for me at gate 9.", "Wait at exit 9."]
        },
        {
          "partner_zh": "好的。外面冷吗？",
          "partner_en": "OK. Is it cold outside?",
          "prompt_en": "Say it's a bit cold — put on more layers.",
          "answers_zh": ["有点冷，多穿点。", "有点冷。"],
          "answers_en": ["A bit cold — wrap up warm.", "A bit cold."]
        },
        {
          "partner_zh": "好，一会儿见！",
          "partner_en": "OK, see you in a bit!",
          "prompt_en": "Say see you soon.",
          "answers_zh": ["一会儿见！", "好，马上到！"],
          "answers_en": ["See you soon!", "OK, nearly there!"]
        }
      ],
      "closing_zh": "好的，拜拜！",
      "closing_en": "OK, bye!"
    },
    {
      "id": "2026-10-25-m2",
      "level": 1,
      "title": "Helping an elderly man",
      "role": "老人",
      "goal": "An old man is lost: offer to help, find out where he's going and take him there.",
      "new_words": [
        { "word": "老人", "english": "old person" },
        { "word": "记住", "english": "to remember" }
      ],
      "steps": [
        {
          "partner_zh": "你好，能帮我一下吗？我是老人，找不到路了。",
          "partner_en": "Hello, could you help me? I'm an old man and I've got lost.",
          "prompt_en": "Say of course, what's wrong?",
          "answers_zh": ["当然，怎么了？", "好的，有什么事？"],
          "answers_en": ["Of course, what's the matter?", "Sure, what can I do?"]
        },
        {
          "partner_zh": "我要去医院，可是我没记住怎么走。",
          "partner_en": "I need to get to the hospital, but I can't remember the way.",
          "prompt_en": "Ask which hospital.",
          "answers_zh": ["您去哪个医院？", "哪个医院？"],
          "answers_en": ["Which hospital are you going to?", "Which hospital?"]
        },
        {
          "partner_zh": "人民医院。",
          "partner_en": "The People's Hospital.",
          "prompt_en": "Say it's not far — you'll take him.",
          "answers_zh": ["不远，我带您去。", "我送您过去吧。"],
          "answers_en": ["It's not far — I'll take you.", "Let me walk you there."]
        },
        {
          "partner_zh": "太谢谢你了！你真好。",
          "partner_en": "Thank you so much! You're very kind.",
          "prompt_en": "Say it's nothing.",
          "answers_zh": ["没什么。", "不客气。"],
          "answers_en": ["It's nothing.", "You're welcome."]
        },
        {
          "partner_zh": "你是哪国人？中文说得很好！",
          "partner_en": "Where are you from? Your Chinese is very good!",
          "prompt_en": "Say you're British and still learning.",
          "answers_zh": ["我是英国人，还在学习。", "谢谢，我还在学。"],
          "answers_en": ["I'm British — I'm still learning.", "Thanks, I'm still learning."]
        }
      ],
      "closing_zh": "好孩子，谢谢你！",
      "closing_en": "Good lad, thank you!"
    }
  ]
