  "missions": [
    {
      "id": "2026-11-13-m1",
      "level": 1,
      "title": "Dictation in class",
      "role": "老师",
      "goal": "Your teacher gives a dictation from today's text: get ready, ask them to slow down, and check your answer.",
      "new_words": [
        {
          "word": "听写",
          "english": "dictation"
        },
        {
          "word": "课文",
          "english": "text (in a textbook)"
        },
        {
          "word": "一下儿",
          "english": "briefly; for a moment"
        }
      ],
      "steps": [
        {
          "partner_zh": "今天我们听写课文里的字。",
          "partner_en": "Today we'll do a dictation of characters from the text.",
          "prompt_en": "Say you're ready.",
          "answers_zh": [
            "好，我准备好了。",
            "好的，老师。"
          ],
          "answers_en": [
            "OK, I'm ready.",
            "OK, teacher."
          ]
        },
        {
          "partner_zh": "第一个：火车站。",
          "partner_en": "Number one: train station.",
          "prompt_en": "Ask them to say it slowly once more.",
          "answers_zh": [
            "老师，请慢点说。",
            "请您再说一下儿。"
          ],
          "answers_en": [
            "Teacher, please say it slowly.",
            "Could you say it again?"
          ]
        },
        {
          "partner_zh": "火车站。写好了吗？",
          "partner_en": "Train station. Have you written it?",
          "prompt_en": "Say yes, and ask if it's right.",
          "answers_zh": [
            "写好了，对吗？",
            "写好了。您看一下儿，对不对？"
          ],
          "answers_en": [
            "Done. Is it right?",
            "Done. Could you have a look — is it right?"
          ]
        },
        {
          "partner_zh": "对了！写得很好。",
          "partner_en": "That's right! Nicely written.",
          "prompt_en": "Say thank you.",
          "answers_zh": [
            "谢谢老师！",
            "太好了，谢谢！"
          ],
          "answers_en": [
            "Thank you!",
            "Great, thanks!"
          ]
        }
      ],
      "closing_zh": "好，我们听写下一个。",
      "closing_en": "Good, on to the next one."
    },
    {
      "id": "2026-11-13-m2",
      "level": 1,
      "title": "Noodles for two",
      "role": "饭店老板",
      "goal": "Order noodles for yourself and a child in a small restaurant, and pay.",
      "new_words": [
        {
          "word": "面条儿",
          "english": "noodles"
        },
        {
          "word": "小孩儿",
          "english": "child"
        }
      ],
      "steps": [
        {
          "partner_zh": "你们好！几个人？",
          "partner_en": "Hello! How many of you?",
          "prompt_en": "Say two: you and a child.",
          "answers_zh": [
            "两个人，我和一个小孩儿。",
            "两个。"
          ],
          "answers_en": [
            "Two — me and a child.",
            "Two."
          ]
        },
        {
          "partner_zh": "请坐。你们吃什么？",
          "partner_en": "Have a seat. What would you like?",
          "prompt_en": "Say two portions of noodles.",
          "answers_zh": [
            "我们要两个面条儿。",
            "两个面条儿。"
          ],
          "answers_en": [
            "We'd like two noodles.",
            "Two noodles, please."
          ]
        },
        {
          "partner_zh": "好。喝什么？",
          "partner_en": "Sure. Anything to drink?",
          "prompt_en": "Say tea for you, water for the child.",
          "answers_zh": [
            "我喝茶，小孩儿喝水。",
            "一杯茶，一杯水。"
          ],
          "answers_en": [
            "Tea for me, water for the child.",
            "One tea, one water."
          ]
        },
        {
          "partner_zh": "一共三十块。",
          "partner_en": "That's thirty kuai altogether.",
          "prompt_en": "Say here you go.",
          "answers_zh": [
            "给你。",
            "好，给您钱。"
          ],
          "answers_en": [
            "Here you go.",
            "OK, here's the money."
          ]
        }
      ],
      "closing_zh": "谢谢！面条儿马上就好。",
      "closing_en": "Thanks! The noodles will be right up."
    }
  ]
}
