  "missions": [
    {
      "id": "2026-10-22-m1",
      "level": 1,
      "title": "Asking a classmate for help",
      "role": "同学",
      "goal": "Ask a classmate to help with today's class, find out when the exam is and plan to study together.",
      "new_words": [
        { "word": "同学", "english": "classmate" },
        { "word": "帮忙", "english": "to help" },
        { "word": "考试", "english": "exam" }
      ],
      "steps": [
        {
          "partner_zh": "你好！有什么事？",
          "partner_en": "Hi! What's up?",
          "prompt_en": "Ask if they can help you.",
          "answers_zh": ["你能帮个忙吗？", "可以帮我一下吗？"],
          "answers_en": ["Could you do me a favour?", "Can you help me?"]
        },
        {
          "partner_zh": "可以啊，怎么了？",
          "partner_en": "Sure, what's wrong?",
          "prompt_en": "Say you didn't really understand today's class.",
          "answers_zh": ["今天的课我不太明白。", "今天的课我听不懂。"],
          "answers_en": ["I didn't really understand today's class.", "I couldn't follow today's class."]
        },
        {
          "partner_zh": "没问题，我给你说说。",
          "partner_en": "No problem, I'll go through it with you.",
          "prompt_en": "Ask when the exam is.",
          "answers_zh": ["考试是什么时候？", "什么时候考试？"],
          "answers_en": ["When's the exam?", "When is the exam?"]
        },
        {
          "partner_zh": "下个星期一。",
          "partner_en": "Next Monday.",
          "prompt_en": "Suggest studying together tomorrow.",
          "answers_zh": ["明天我们一起学习吧？", "明天一起学，好吗？"],
          "answers_en": ["Shall we study together tomorrow?", "Let's study together tomorrow, OK?"]
        },
        {
          "partner_zh": "好啊，明天下午见。",
          "partner_en": "Sure, see you tomorrow afternoon.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["太好了，谢谢你！", "谢谢，明天见！"],
          "answers_en": ["Great, thank you!", "Thanks, see you tomorrow!"]
        }
      ],
      "closing_zh": "不客气！",
      "closing_en": "You're welcome!"
    },
    {
      "id": "2026-10-22-m2",
      "level": 1,
      "title": "Phoning a shop for directions",
      "role": "店员",
      "goal": "Call a bookshop, find out where it is and when it closes, and say when you'll arrive.",
      "new_words": [
        { "word": "旁边", "english": "next to" },
        { "word": "北", "english": "north" },
        { "word": "进来", "english": "to come in" }
      ],
      "steps": [
        {
          "partner_zh": "你好，这里是小王书店。",
          "partner_en": "Hello, Xiao Wang's Bookshop.",
          "prompt_en": "Ask where the shop is.",
          "answers_zh": ["请问你们在哪儿？", "你们的店在哪里？"],
          "answers_en": ["Excuse me, where are you?", "Where's your shop?"]
        },
        {
          "partner_zh": "我们在银行旁边。",
          "partner_en": "We're next to the bank.",
          "prompt_en": "Ask if it's the bank on the north side.",
          "answers_zh": ["是北边那个银行吗？", "北边的银行？"],
          "answers_en": ["Is it the bank on the north side?", "The north-side bank?"]
        },
        {
          "partner_zh": "对，北边那个。",
          "partner_en": "Yes, the north one.",
          "prompt_en": "Ask what time they close.",
          "answers_zh": ["你们几点关门？", "晚上几点关门？"],
          "answers_en": ["What time do you close?", "What time do you close tonight?"]
        },
        {
          "partner_zh": "九点关门。",
          "partner_en": "We close at nine.",
          "prompt_en": "Say you'll come at eight.",
          "answers_zh": ["我八点去。", "好，我八点到。"],
          "answers_en": ["I'll come at eight.", "OK, I'll be there at eight."]
        },
        {
          "partner_zh": "好的，到了直接进来就行。",
          "partner_en": "OK, just come straight in when you get here.",
          "prompt_en": "Say OK, thanks.",
          "answers_zh": ["好的，谢谢！", "好，一会儿见。"],
          "answers_en": ["OK, thanks!", "OK, see you soon."]
        }
      ],
      "closing_zh": "好，等你！",
      "closing_en": "Great, see you then!"
    }
  ]
}
