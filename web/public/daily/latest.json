          "partner_en": "Today we're learning to write characters.",
          "prompt_en": "Say great, but characters are hard.",
          "answers_zh": ["好啊，可是汉字很难。", "汉字很难。"],
          "answers_en": ["Great, but characters are hard.", "Characters are hard."]
        },
        {
          "partner_zh": "没关系，慢慢来。这个字你认识吗？",
          "partner_en": "Don't worry, take it slowly. Do you know this character?",
          "prompt_en": "Say yes, it's 大 (big).",
          "answers_zh": ["认识，是“大”。", "是大小的“大”。"],
          "answers_en": ["Yes, it's 'big'.", "It's 'big', as in 'big and small'."]
        },
        {
          "partner_zh": "对！你写一下。",
          "partner_en": "Right! Have a go at writing it.",
          "prompt_en": "Write it, then ask if it's right.",
          "answers_zh": ["我写好了，对吗？", "这样对吗？"],
          "answers_en": ["Done — is that right?", "Is this right?"]
        },
        {
          "partner_zh": "写得很好！",
          "partner_en": "That's very well written!",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢老师！", "谢谢！"],
          "answers_en": ["Thank you!", "Thanks!"]
        },
        {
          "partner_zh": "不客气。明天再学五个字。",
          "partner_en": "You're welcome. Tomorrow we'll learn five more.",
          "prompt_en": "Say OK, see you tomorrow.",
          "answers_zh": ["好的，明天见！", "没问题。"],
          "answers_en": ["OK, see you tomorrow!", "No problem."]
        }
      ],
      "closing_zh": "明天见！",
      "closing_en": "See you tomorrow!"
    }
