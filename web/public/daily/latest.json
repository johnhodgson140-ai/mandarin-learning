      "new_words": [
        { "word": "放学", "english": "school finishes (for the day)" },
        { "word": "弟", "english": "younger brother" }
      ],
      "steps": [
        {
          "partner_zh": "你好，你找谁？",
          "partner_en": "Hello, who are you here for?",
          "prompt_en": "Say you're here to collect your little brother.",
          "answers_zh": ["我来接我弟弟。", "我找我弟。"],
          "answers_en": ["I'm here to pick up my little brother.", "I'm here for my brother."]
        },
        {
          "partner_zh": "他叫什么名字？",
          "partner_en": "What's his name?",
          "prompt_en": "Say his name is Xiao Ming.",
          "answers_zh": ["他叫小明。", "小明。"],
          "answers_en": ["His name's Xiao Ming.", "Xiao Ming."]
        },
        {
          "partner_zh": "他们四点放学，还有十分钟。",
          "partner_en": "They finish at four — ten more minutes.",
          "prompt_en": "Say OK, you'll wait.",
          "answers_zh": ["没关系，我等他。", "好，我等一下。"],
          "answers_en": ["That's fine, I'll wait for him.", "OK, I'll wait."]
        },
        {
          "partner_zh": "你是他的家人吗？",
          "partner_en": "Are you family?",
          "prompt_en": "Say yes, you're his older sibling.",
          "answers_zh": ["是的，我是他哥哥。", "对，我是他姐姐。"],
          "answers_en": ["Yes, I'm his big brother.", "Yes, I'm his big sister."]
        },
        {
          "partner_zh": "好的，他马上出来。",
          "partner_en": "OK, he'll be out in a moment.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢老师！", "好的，谢谢！"],
          "answers_en": ["Thank you!", "OK, thanks!"]
        }
      ],
      "closing_zh": "不客气。",
      "closing_en": "You're welcome."
    },
