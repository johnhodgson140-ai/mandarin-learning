    {
      "id": "2026-11-05-s1",
      "level": 1,
      "topic": "travel",
      "title_zh": "机票和门票",
      "title_en": "Plane tickets and entry tickets",
      "paragraphs": [
        ["我", "想", "去", "北京", "玩", "。", "我", "在", "网上", "买", "了", "机票", "。", "票", "不", "贵", "，", "我", "很", "高兴", "。"],
        ["到", "了", "北京", "，", "我", "坐", "车", "去", "一", "个", "很", "大", "的", "老", "地方", "。"],
        ["下车", "后", "，", "我", "去", "买", "门票", "。", "要", "一百", "块", "！", "有些", "贵", "，", "我", "还是", "买", "了", "。"],
        ["那里", "真", "好", "。", "我", "觉得", "，", "一百", "块", "也", "不", "多", "。", "下", "次", "我", "还", "想", "来", "！"]
      ],
      "translations": [
        "I wanted to go to Beijing, so I bought a plane ticket online. It wasn't expensive, and I was really pleased.",
        "When I got to Beijing, I took a bus to a big historic site.",
        "After I got off, I went to buy a ticket. It was a hundred kuai! A bit expensive, but I bought one anyway.",
        "It was wonderful there. I think a hundred kuai wasn’t much after all. I want to come again next time!"
      ],
      "names": ["北京"],
      "new_words": ["机票", "下车", "门票"],
      "glossary": [
        { "word": "机票", "english": "plane ticket" },
        { "word": "下车", "english": "to get off (a bus, car)" },
        { "word": "门票", "english": "entry ticket" },
        { "word": "北京", "english": "Beijing" }
      ]
    },
    {
      "id": "2026-11-05-s2",
      "level": 1,
      "topic": "football",
      "title_zh": "下雨了",
      "title_en": "It rained",
      "paragraphs": [
        ["今天", "下午", "，", "我", "想", "和", "朋友", "们", "去", "打球", "。", "两", "点", "，", "下雨", "了", "。"],
        ["雨", "很", "大", "，", "我们", "不", "能", "出去", "了", "。"],
        ["朋友", "说", "：", "“", "我", "家", "楼上", "有", "一", "个", "大", "房间", "，", "我们", "去", "那里", "玩", "吧", "！", "”"],
        ["我们", "在", "楼上", "玩", "了", "两", "个", "小时", "的", "球", "。", "楼下", "的", "人", "来", "了", "，", "说", "：", "“", "你们", "别", "玩", "了", "！", "”"],
        ["我们", "都", "笑", "了", "，", "就", "去", "看", "电视", "了", "。"]
      ],
      "translations": [
        "This afternoon I wanted to play football with my friends. At two, it started raining.",
        "It was pouring, so we couldn't go out.",
        "My friend said: “There’s a big room upstairs at my place — let’s play there!”",
        "We played ball upstairs for two hours. The people downstairs came up and said: “Stop playing!”",
        "We all laughed, and went to watch TV instead."
      ],
      "names": [],
      "new_words": ["打球", "下雨", "楼上"],
      "glossary": [
        { "word": "打球", "english": "to play ball" },
        { "word": "下雨", "english": "to rain" },
        { "word": "楼上", "english": "upstairs" }
      ]
    }
  ],
  "missions": [
    {
      "id": "2026-11-05-m1",
      "level": 1,
      "title": "At the ticket office",
      "role": "售票员",
      "goal": "Buy two entry tickets, ask about a student discount, and check whether you can bring your cup in.",
      "new_words": [
        { "word": "门票", "english": "entry ticket" },
        { "word": "杯子", "english": "cup" }
      ],
      "steps": [
        {
          "partner_zh": "你好！几个人？",
          "partner_en": "Hello! How many?",
          "prompt_en": "Say two tickets.",
          "answers_zh": ["两张门票。", "两个人。"],
          "answers_en": ["Two tickets.", "Two people."]
        },
        {
          "partner_zh": "一张门票五十块。",
          "partner_en": "It's fifty kuai per ticket.",
          "prompt_en": "Ask if students pay less.",
          "answers_zh": ["学生票多少钱？", "学生便宜吗？"],
          "answers_en": ["How much is a student ticket?", "Is it cheaper for students?"]
        },
        {
          "partner_zh": "学生半价，二十五块。",
          "partner_en": "Students pay half — twenty-five kuai.",
          "prompt_en": "Say you're both students.",
          "answers_zh": ["我们都是学生。", "我们是大学生。"],
          "answers_en": ["We're both students.", "We're university students."]
        },
        {
          "partner_zh": "好的，一共五十块。",
          "partner_en": "OK, fifty kuai altogether.",
          "prompt_en": "Ask if you can take your cup in.",
          "answers_zh": ["杯子可以带进去吗？", "我能拿杯子进去吗？"],
          "answers_en": ["Can I take my cup in?", "Am I allowed to bring my cup in?"]
        },
        {
          "partner_zh": "可以，但是里边不能喝。",
          "partner_en": "Yes, but you can't drink inside.",
          "prompt_en": "Say OK, got it, thanks.",
          "answers_zh": ["明白了，谢谢。", "好的，谢谢！"],
          "answers_en": ["Got it, thanks.", "OK, thank you!"]
        }
      ],
      "closing_zh": "请进，玩得开心！",
      "closing_en": "Go on in — enjoy!"
    },
    {
      "id": "2026-11-05-m2",
      "level": 1,
      "title": "Getting out of a taxi",
      "role": "司机",
      "goal": "Take a taxi to the shopping centre, agree where to get out and pay.",
      "new_words": [
        { "word": "下车", "english": "to get out (of a car)" },
        { "word": "马路", "english": "road; street" }
      ],
      "steps": [
        {
          "partner_zh": "去哪儿？",
          "partner_en": "Where to?",
          "prompt_en": "Say the shopping centre.",
          "answers_zh": ["我要去商场。", "去商场。"],
          "answers_en": ["To the shopping centre, please.", "The shopping centre."]
        },
        {
          "partner_zh": "到了，你在这儿下车吗？",
          "partner_en": "We're here — do you want to get out here?",
          "prompt_en": "Ask if they can stop on the other side of the road.",
          "answers_zh": ["能去马路对面吗？", "去马路那边吧。"],
          "answers_en": ["Could you go to the other side of the road?", "The other side of the road, please."]
        },
        {
          "partner_zh": "那边不能停车。",
          "partner_en": "I can't stop over there.",
          "prompt_en": "Say OK, you'll get out here.",
          "answers_zh": ["好，我在这儿下车。", "那就这儿吧。"],
          "answers_en": ["OK, I'll get out here.", "Here's fine, then."]
        },
        {
          "partner_zh": "二十八块。",
          "partner_en": "Twenty-eight kuai.",
          "prompt_en": "Say you'll pay by phone.",
          "answers_zh": ["我用手机给。", "可以用手机吗？"],
          "answers_en": ["I'll pay by phone.", "Can I pay by phone?"]
        },
        {
          "partner_zh": "好了。过马路小心！",
          "partner_en": "All done. Careful crossing the road!",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢师傅！", "好的，谢谢！"],
          "answers_en": ["Thanks!", "OK, thank you!"]
        }
      ],
      "closing_zh": "再见！",
      "closing_en": "Bye!"
    }
  ]
}
