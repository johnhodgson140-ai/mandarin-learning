    {
      "id": "2026-11-11-m1",
      "level": 1,
      "title": "Where's my phone?",
      "role": "室友",
      "goal": "Your flatmate helps you look for your phone before you both head out.",
      "new_words": [
        { "word": "下边", "english": "underneath" },
        { "word": "上边", "english": "on top" }
      ],
      "steps": [
        {
          "partner_zh": "你在找什么？",
          "partner_en": "What are you looking for?",
          "prompt_en": "Say your phone.",
          "answers_zh": ["我在找我的手机。", "我的手机呢？"],
          "answers_en": ["I'm looking for my phone.", "Where's my phone?"]
        },
        {
          "partner_zh": "你看看桌子下边。",
          "partner_en": "Have a look under the table.",
          "prompt_en": "Say it's not there.",
          "answers_zh": ["不在下边。", "没有。"],
          "answers_en": ["It's not under there.", "Nope."]
        },
        {
          "partner_zh": "那在床上边吗？",
          "partner_en": "Is it on the bed, then?",
          "prompt_en": "Say you've found it — it's on the bed!",
          "answers_zh": ["找到了！在床上边。", "在这儿！"],
          "answers_en": ["Found it! It's on the bed.", "Here it is!"]
        },
        {
          "partner_zh": "太好了！我们走吧，要晚了。",
          "partner_en": "Great! Let's go, we're going to be late.",
          "prompt_en": "Say OK, let's go.",
          "answers_zh": ["好，走吧！", "好的，马上走。"],
          "answers_en": ["OK, let's go!", "OK, coming now."]
        }
      ],
      "closing_zh": "快点！",
      "closing_en": "Hurry up!"
    },
    {
