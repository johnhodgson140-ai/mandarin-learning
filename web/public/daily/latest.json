      "title_en": "Yesterday's film",
      "paragraphs": [
        ["昨天", "晚上", "，", "我", "在", "家", "看", "了", "一", "个", "电影", "。"],
        ["这", "个", "是", "日本", "的", "，", "叫", "《", "千与千寻", "》", "。"],
        ["电影", "里", "有", "一", "个", "孩子", "。", "她", "要", "帮", "她", "的", "妈妈", "。"],
