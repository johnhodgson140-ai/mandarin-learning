  "missions": [
    {
      "id": "2026-11-06-m1",
      "level": 1,
      "title": "Do you speak Chinese?",
      "role": "店员",
      "goal": "A shop assistant is surprised you speak Chinese: say how long and where you've learned, and what's hard.",
      "new_words": [
        { "word": "中文", "english": "Chinese (language)" },
        { "word": "一点儿", "english": "a little" }
      ],
      "steps": [
        {
          "partner_zh": "你会说中文吗？",
          "partner_en": "Can you speak Chinese?",
          "prompt_en": "Say a little.",
          "answers_zh": ["会一点儿。", "我会说一点儿中文。"],
          "answers_en": ["A little.", "I can speak a little Chinese."]
        },
        {
          "partner_zh": "说得很好啊！你学了多长时间？",
          "partner_en": "You speak it really well! How long have you been learning?",
          "prompt_en": "Say half a year.",
          "answers_zh": ["我学了半年。", "半年。"],
          "answers_en": ["I've been learning for half a year.", "Six months."]
        },
        {
          "partner_zh": "你在哪儿学的？",
          "partner_en": "Where did you learn?",
          "prompt_en": "Say at university and online.",
          "answers_zh": ["在大学，也在网上学。", "在大学学的。"],
          "answers_en": ["At university, and online too.", "At university."]
        },
        {
          "partner_zh": "中文难吗？",
          "partner_en": "Is Chinese hard?",
          "prompt_en": "Say characters are hard, but speaking is OK.",
          "answers_zh": ["汉字很难，说话还行。", "写字很难。"],
          "answers_en": ["Characters are hard, but speaking is OK.", "Writing is hard."]
        },
        {
          "partner_zh": "加油！",
          "partner_en": "Keep it up!",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢你！", "谢谢！"],
          "answers_en": ["Thank you!", "Thanks!"]
        }
      ],
      "closing_zh": "不客气，欢迎再来！",
      "closing_en": "You're welcome — come again!"
    },
    {
      "id": "2026-11-06-m2",
