      ],
      "steps": [
        {
          "partner_zh": "你好，去哪儿？",
          "partner_en": "Hello, where to?",
          "prompt_en": "Say two tickets to Beijing.",
          "answers_zh": [
            "去北京，两个人。",
            "我要两张去北京的票。"
          ],
          "answers_en": [
            "Beijing, for two.",
            "Two tickets to Beijing, please."
          ]
        },
        {
          "partner_zh": "今天上午的票已经没有了，只有下午的。",
          "partner_en": "This morning's tickets are sold out — there are only afternoon ones.",
          "prompt_en": "Ask what time in the afternoon.",
          "answers_zh": [
            "下午几点的？",
            "下午几点？"
          ],
          "answers_en": [
            "What time in the afternoon?",
            "What time?"
          ]
        },
        {
          "partner_zh": "下午三点的。可能有点晚。",
          "partner_en": "Three o'clock. It might be a bit late.",
          "prompt_en": "Say that's fine, you'll take them.",
          "answers_zh": [
            "没关系，就要三点的。",
            "可以，我要了。"
          ],
          "answers_en": [
            "That's fine, I'll take the three o'clock.",
            "OK, I'll take them."
          ]
        },
        {
          "partner_zh": "两张，一共四百块。",
          "partner_en": "Two tickets, four hundred altogether.",
          "prompt_en": "Say wow, so expensive — then pay.",
          "answers_zh": [
            "这么贵啊！好，给你。",
            "这么贵！给你钱。"
          ],
          "answers_en": [
            "That expensive! OK, here you go.",
            "So pricey! Here's the money."
          ]
        }
      ],
      "closing_zh": "好，这是你们的票。",
      "closing_en": "Right, here are your tickets."
    },
