      "title": "Asking the way to the station",
      "role": "路人",
      "goal": "Ask a passer-by the way to the metro station, check how far it is and thank them.",
      "new_words": [
        { "word": "第二", "english": "second; number two" },
        { "word": "外", "english": "outside" }
      ],
      "steps": [
        {
          "partner_zh": "你好，有什么事吗？",
          "partner_en": "Hi, can I help you?",
          "prompt_en": "Ask where the metro station is.",
          "answers_zh": ["请问，地铁站在哪儿？", "请问，地铁站怎么走？"],
          "answers_en": ["Excuse me, where is the metro station?", "Excuse me, how do I get to the metro station?"]
        },
        {
          "partner_zh": "一直走，第二个路口往左。",
          "partner_en": "Go straight on, and turn left at the second junction.",
          "prompt_en": "Ask if it's far.",
          "answers_zh": ["远吗？", "离这里远吗？"],
          "answers_en": ["Is it far?", "Is it far from here?"]
        },
        {
          "partner_zh": "不远，就在大商店外面，走五分钟就到了。",
          "partner_en": "Not far. It's just outside the big shop, five minutes' walk.",
          "prompt_en": "Check it's the second junction.",
          "answers_zh": ["是第二个路口吗？", "第二个，对吗？"],
          "answers_en": ["Is it the second junction?", "The second one, right?"]
        },
        {
          "partner_zh": "对，第二个。",
          "partner_en": "Yes, the second one.",
          "prompt_en": "Say thank you.",
          "answers_zh": ["谢谢你！", "好的，谢谢！"],
          "answers_en": ["Thank you!", "OK, thanks!"]
        }
      ],
      "closing_zh": "不客气！",
      "closing_en": "You're welcome!"
    },
