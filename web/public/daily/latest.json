    {
      "id": "2026-10-06-m1",
      "level": 1,
      "title": "Seeing a doctor",
      "role": "医生",
      "goal": "Say what hurts and how it happened, and ask when you can play football again.",
      "new_words": [
        { "word": "动", "english": "to move" },
        { "word": "重", "english": "serious; heavy" }
      ],
      "steps": [
        {
          "partner_zh": "你好，哪里不舒服？",
          "partner_en": "Hello, what's the problem?",
          "prompt_en": "Say your hand hurts.",
          "answers_zh": ["我的手很疼。", "我手疼。"],
          "answers_en": ["My hand really hurts.", "My hand hurts."]
        },
        {
          "partner_zh": "怎么了？",
          "partner_en": "What happened?",
          "prompt_en": "Say you fell while playing football yesterday.",
          "answers_zh": ["昨天踢球的时候摔了。", "我踢球摔了。"],
          "answers_en": ["I fell playing football yesterday.", "I fell while playing football."]
        },
        {
          "partner_zh": "你动一下手。",
          "partner_en": "Try moving your hand.",
          "prompt_en": "Say you can't move it, it hurts.",
          "answers_zh": ["动不了，很疼。", "我动不了。"],
          "answers_en": ["I can't move it, it hurts.", "I can't move it."]
        },
        {
          "partner_zh": "不太重，休息几天就好了。",
          "partner_en": "It's not too serious. Rest for a few days and it'll be fine.",
          "prompt_en": "Ask when you can play football.",
          "answers_zh": ["什么时候能踢球？", "我能踢球吗？"],
          "answers_en": ["When can I play football?", "Can I play football?"]
        },
        {
          "partner_zh": "这个星期别踢了。",
          "partner_en": "Don't play this week.",
          "prompt_en": "Say OK, thanks doctor.",
          "answers_zh": ["好的，谢谢医生！", "好，谢谢！"],
          "answers_en": ["OK, thank you, doctor!", "OK, thanks!"]
        }
      ],
      "closing_zh": "不客气，回家好好休息。",
      "closing_en": "You're welcome. Go home and get some good rest."
    },
