  "missions": [
    {
      "id": "2026-11-03-m1",
      "level": 1,
      "title": "Meeting another student",
      "role": "同学",
      "goal": "Chat with a Chinese student: say you're at university, where you're from and what you study, and swap contacts.",
      "new_words": [
        { "word": "大学生", "english": "university student" },
        { "word": "外国", "english": "foreign" }
      ],
      "steps": [
        {
          "partner_zh": "你好，你也是大学生吗？",
          "partner_en": "Hi, are you a university student too?",
          "prompt_en": "Say yes, you're at university in London.",
          "answers_zh": ["是的，我在伦敦上大学。", "对，我是大学生。"],
          "answers_en": ["Yes, I'm at university in London.", "Yes, I'm a university student."]
        },
        {
          "partner_zh": "你是外国人吧？",
          "partner_en": "You're not from here, are you?",
          "prompt_en": "Say yes, you're British.",
          "answers_zh": ["对，我是英国人。", "是的，我从英国来。"],
          "answers_en": ["That's right, I'm British.", "Yes, I'm from the UK."]
        },
        {
          "partner_zh": "你学什么？",
          "partner_en": "What do you study?",
          "prompt_en": "Say accounting and finance.",
          "answers_zh": ["我学会计和金融。", "我学会计。"],
          "answers_en": ["I study accounting and finance.", "I study accounting."]
        },
        {
          "partner_zh": "很好！你中文说得很好。",
          "partner_en": "Great! Your Chinese is really good.",
          "prompt_en": "Say thanks, you're still learning.",
          "answers_zh": ["谢谢，我还在学习。", "哪里，我说得不好。"],
          "answers_en": ["Thanks, I'm still learning.", "Oh no, it's not that good."]
        },
        {
          "partner_zh": "我们加个微信吧？",
          "partner_en": "Shall we add each other on WeChat?",
          "prompt_en": "Say sure.",
          "answers_zh": ["好啊！", "当然可以！"],
          "answers_en": ["Sure!", "Of course!"]
        }
      ],
      "closing_zh": "好，以后常联系！",
      "closing_en": "Great, let's keep in touch!"
    },
    {
      "id": "2026-11-03-m2",
      "level": 1,
