    {
      "id": "2026-11-26-m1",
      "level": 2,
      "title": "Ordering a drink",
      "role": "服务员",
      "goal": "Order a drink at a tea shop and ask for it the way you like it.",
      "new_words": [
        {
          "word": "加",
          "english": "to add"
        },
        {
          "word": "特别",
          "english": "especially; special"
        }
      ],
      "steps": [
        {
          "partner_zh": "你好，喝什么？",
          "partner_en": "Hi, what would you like to drink?",
          "prompt_en": "Ask what's especially good here.",
          "answers_zh": [
            "你们这里什么特别好喝？",
            "有什么特别的吗？"
          ],
          "answers_en": [
            "What's especially good here?",
            "Is there anything special?"
          ]
        },
        {
          "partner_zh": "这个茶大家都喜欢。",
          "partner_en": "Everyone loves this tea.",
          "prompt_en": "Say OK, one cup.",
          "answers_zh": [
            "好，要一杯。",
            "那我要一杯。"
          ],
          "answers_en": [
            "OK, one cup please.",
            "I'll have one then."
          ]
        },
        {
          "partner_zh": "要热的还是冷的？",
          "partner_en": "Hot or cold?",
          "prompt_en": "Say hot, please.",
          "answers_zh": [
            "热的。",
            "我要热的。"
          ],
          "answers_en": [
            "Hot.",
            "Hot, please."
          ]
        },
        {
          "partner_zh": "要加奶吗？",
          "partner_en": "Would you like milk in it?",
          "prompt_en": "Say yes, add a little milk.",
          "answers_zh": [
            "加一点儿奶，谢谢。",
            "要，加一点儿。"
          ],
          "answers_en": [
            "A little milk, thanks.",
            "Yes, just a bit."
          ]
        }
      ],
      "closing_zh": "好的，一杯热茶，加奶。马上好！",
      "closing_en": "OK — one hot tea with milk. Coming right up!"
    },
    {
      "id": "2026-11-26-m2",
      "level": 2,
      "title": "Bumping into an old classmate",
      "role": "老同学",
      "goal": "You run into a friend from secondary school. Catch up on what's changed.",
      "new_words": [
        {
          "word": "以前",
          "english": "before; in the past"
        },
        {
          "word": "当时",
          "english": "at the time"
        },
        {
          "word": "变",
          "english": "to change"
        }
      ],
      "steps": [
        {
          "partner_zh": "是你吗？我们以前是同学！",
          "partner_en": "Is that you? We were at school together!",
          "prompt_en": "Say yes! Say you were in the same middle school.",
          "answers_zh": [
            "是我！我们是中学同学！",
            "对！我们以前在一个中学。"
          ],
          "answers_en": [
            "It's me! We were at secondary school together!",
            "Yes! We went to the same school."
          ]
        },
        {
          "partner_zh": "你变了很多，我都不认识你了！",
          "partner_en": "You've changed so much, I hardly recognised you!",
          "prompt_en": "Say you've grown taller.",
          "answers_zh": [
            "我变高了。",
            "对，我高了很多。"
          ],
          "answers_en": [
            "I've got taller.",
            "Yeah, I've grown a lot."
          ]
        },
        {
          "partner_zh": "你还记得王老师吗？",
          "partner_en": "Do you remember Mr Wang?",
          "prompt_en": "Say yes — at the time you were scared of him.",
          "answers_zh": [
            "记得！当时我们都怕他。",
            "当然记得，当时他很难。"
          ],
          "answers_en": [
            "Of course! We were all scared of him back then.",
            "Of course — he was tough at the time."
          ]
        },
        {
          "partner_zh": "哈哈，对！我们找时间一起吃饭吧。",
          "partner_en": "Haha, yes! Let's find a time to have a meal together.",
          "prompt_en": "Say good idea, and ask for their phone number.",
          "answers_zh": [
            "好啊！你的电话是多少？",
            "好，给我你的电话吧。"
          ],
          "answers_en": [
            "Great! What's your number?",
            "Sure, give me your number."
          ]
        }
      ],
      "closing_zh": "好，我给你发信息！",
      "closing_en": "OK, I'll message you!"
    }
  ]
